{%- comment -%}
  Password page shell. Same <head> styling as layout/theme.liquid (color
  schemes, type roles, Design System) through snippets/theme-styles.liquid;
  the body only renders the password template's sections.
  Depends on: snippets/theme-styles.liquid, snippets/meta-tags.liquid.
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>

    {% render 'meta-tags' %}
    {% render 'theme-styles' %}

    {{ content_for_header }}
  </head>

  <body class="template-password color-{{ settings.color_schemes.first.id }}">
    <main id="MainContent" class="content-for-layout" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
