  When a section omits this optional setting, Minimal borders inherit the
  global Design System checkbox.

  `section_width_affects_carousels` is intentionally not part of this section
  contract. It is global-only and is read from `settings` by the snippet.
{%- endcomment -%}

{%- liquid
  # Cap is opt-in and INDEPENDENT of Design Mode: it resolves from the Enable
  # Cap checkbox alone, never from Modern/Minimal. Off by default, matching the
  # theme's hidden-until-enabled convention.
  #
  # Scope precedence: this snippet is reached with a section `source` only in
  # Blend or Custom mode. The section checkbox is authoritative — including
  # when it is OFF. `default:` cannot express that: Liquid treats false as empty, so
  # `source.design_enable_section_width | default: settings.design_enable_section_width` would let
  # a section that deliberately turned cap off inherit the global cap instead.
  assign cap_enabled = false
  if source.design_enable_section_width
    assign cap_enabled = true
  endif

  assign cap_mobile = 'none'
  assign cap_desktop = 'none'
  if cap_enabled
    assign cap_mobile = source.design_section_width_mobile | default: 'none'
    assign cap_desktop = source.design_section_width_desktop | default: 'tv'
  endif

  # Carousel cap(Width or Max Width Constrain) is a separate, GLOBAL-ONLY opt-in (no per-section override):
  # carousels stay edge-bleed even when the main cap above is enabled, unless
  # this second toggle is also on. Narrows the main toggle, never widens it.
  #
  # It is only shown in the editor when the GLOBAL Enable Section Width is on, so that is
  # the condition it applies under — a section that turns cap on for itself
  # must not activate a toggle the merchant could not see when they set it.
  # The scope's own cap_enabled then narrows it further.
  assign carousel_cap_enabled = false
  if settings.design_enable_section_width and source.section_width_affects_carousels
    assign carousel_cap_enabled = true
  endif

  assign carousel_cap_mobile = 'none'
  assign carousel_cap_desktop = 'none'
  if cap_enabled and carousel_cap_enabled
    assign carousel_cap_mobile = cap_mobile
    assign carousel_cap_desktop = cap_desktop
  endif
-%}

{%- comment -%}
  Cap sits outside the Modern/Minimal branches and Design Mode: it is an independent
  opt-in.
{%- endcomment -%}
--ds-section-width-mobile: {% render 'cap-token', key: cap_mobile %};
--ds-section-width-desktop: {% render 'cap-token', key: cap_desktop %};

--ds-carousel-cap-mobile: {% render 'cap-token', key: carousel_cap_mobile %};
--ds-carousel-cap-desktop: {% render 'cap-token', key: carousel_cap_desktop %};

{%- if source.section_design_mode == 'custom' or source.section_design_mode == 'blend' -%}
  {%- liquid
    assign section_design_mode = source.section_design_mode | default: 'auto'
    assign uses_section_values = false
    if section_design_mode == 'custom' or section_design_mode == 'blend'
      assign uses_section_values = true
    endif

    assign mobile_mode = settings.design_mode_mobile | default: 'modern'
    assign desktop_mode = settings.design_mode_desktop | default: 'modern'
    if section_design_mode == 'custom'
      assign mobile_mode = source.design_mode_mobile | default: 'modern'
      assign desktop_mode = source.design_mode_desktop | default: 'modern'
    endif

    assign section_padding_mobile = source.design_section_padding_mobile | default: settings.design_section_padding_mobile | default: 'lg'
    assign section_padding_desktop = source.design_section_padding_desktop | default: settings.design_section_padding_desktop | default: 'xl'
    assign layout_gap_mobile = source.design_layout_gap_mobile | default: settings.design_layout_gap_mobile | default: 'sm'
    assign layout_gap_desktop = source.design_layout_gap_desktop | default: settings.design_layout_gap_desktop | default: 'md'
    assign gutter_mobile = source.design_gutter_mobile | default: settings.design_gutter_mobile | default: 'md'
    assign gutter_desktop = source.design_gutter_desktop | default: settings.design_gutter_desktop | default: 'lg'
    # Layout gap historically remained enabled in Minimal. Preserve that
    # behavior for sections and saved theme data that predate this setting:
    # only an explicit false is allowed to collapse the resolved gap to zero.
    assign minimal_layout_gap_enabled = true
    if uses_section_values
      if source.design_enable_minimal_layout_gap == true or source.design_enable_minimal_layout_gap == false
        assign minimal_layout_gap_enabled = source.design_enable_minimal_layout_gap
      endif
    elsif settings.design_enable_minimal_layout_gap == true or settings.design_enable_minimal_layout_gap == false
      assign minimal_layout_gap_enabled = settings.design_enable_minimal_layout_gap
    endif
    if uses_section_values
      assign minimal_gutter_enabled = source.design_enable_minimal_gutter
      assign minimal_items_gap_enabled = source.design_enable_minimal_items_gap
    else
      assign minimal_gutter_enabled = settings.design_enable_minimal_gutter
      assign minimal_items_gap_enabled = settings.design_enable_minimal_items_gap
    endif
    assign minimal_borders_enabled = settings.design_enable_minimal_borders
    if uses_section_values
      if source.design_enable_minimal_borders == true or source.design_enable_minimal_borders == false
        assign minimal_borders_enabled = source.design_enable_minimal_borders
      endif
    endif

    assign items_gap_mobile = source.design_items_gap_mobile | default: settings.design_items_gap_mobile | default: 16
    assign items_gap_desktop = source.design_items_gap_desktop | default: settings.design_items_gap_desktop | default: 24

    # Radius is the section's own in Blend and Custom. A section that omits a
    # radius setting falls back to the global value (`default` keeps an
    # explicit 0, which Liquid does not treat as empty).
    assign item_radius_mobile = source.design_item_radius_mobile | default: settings.design_item_radius_mobile | default: 12
    assign item_radius_desktop = source.design_item_radius_desktop | default: settings.design_item_radius_desktop | default: 12
    assign layout_radius_mobile = source.design_layout_radius_mobile | default: settings.design_layout_radius_mobile | default: 16
    assign layout_radius_desktop = source.design_layout_radius_desktop | default: settings.design_layout_radius_desktop | default: 24

    # Blend radius patch: Blend inherits the theme's Modern/Minimal decision,
    # but radius is not part of that inheritance. A Blend section keeps its own
    # radii at a Minimal breakpoint instead of collapsing them to 0px; only a
    # Custom section's own Minimal mode removes radius.
    assign keeps_radius_in_minimal = false
    if section_design_mode == 'blend'
      assign keeps_radius_in_minimal = true
    endif

    assign item_border_width = source.design_item_border_width | default: settings.design_item_border_width | default: 1
    assign layout_border_width = source.design_layout_border_width | default: settings.design_layout_border_width | default: 1
    assign item_border_width_mobile = item_border_width
    assign item_border_width_desktop = item_border_width
    assign layout_border_width_mobile = layout_border_width
    assign layout_border_width_desktop = layout_border_width
    if mobile_mode == 'minimal' and minimal_borders_enabled == false
      assign item_border_width_mobile = 0
      assign layout_border_width_mobile = 0
    endif
    if desktop_mode == 'minimal' and minimal_borders_enabled == false
      assign item_border_width_desktop = 0
      assign layout_border_width_desktop = 0
    endif
    assign item_shadow = source.design_item_shadow | default: settings.design_item_shadow | default: 'md'
    assign surface_shadow = settings.design_surface_shadow | default: 'lg'
  -%}

  --ds-section-padding-mobile: {% render 'space-token', key: section_padding_mobile %}; --ds-section-padding-desktop:
  {% render 'space-token', key: section_padding_desktop %}; --ds-layout-gap-mobile:
  {% if mobile_mode == 'minimal' and minimal_layout_gap_enabled == false -%}
