    {% if minimal_gutter_enabled %}{% render 'space-token', key: gutter_desktop %}{% else %}0px{% endif %};
    --ds-item-gap-desktop: {% if minimal_items_gap_enabled %}{{ items_gap_desktop }}px{% else %}0px{% endif %};
    --ds-item-radius-desktop: {% if keeps_radius_in_minimal %}{{ item_radius_desktop }}px{% else %}0px{% endif %}; --ds-layout-radius-desktop: {% if keeps_radius_in_minimal %}{{ layout_radius_desktop }}px{% else %}0px{% endif %}; --ds-item-shadow-desktop: none;
    --ds-surface-shadow-desktop: none;
  {%- else %}
    --ds-layout-gutter-desktop: {% render 'space-token', key: gutter_desktop %}; --ds-item-gap-desktop:
    {{ items_gap_desktop }}px; --ds-item-radius-desktop: {{ item_radius_desktop }}px; --ds-layout-radius-desktop:
    {{ layout_radius_desktop }}px; --ds-item-shadow-desktop: {% render 'shadow-token', key: item_shadow %};
    --ds-surface-shadow-desktop: {% render 'shadow-token', key: surface_shadow %};
  {%- endif %}

  {%- comment -%}
    Mode-aware multipliers. These are NOT aliases: Minimal mode zeroes them, so
    components that scale a local padding/gap value by them collapse correctly.
    Every pass-through alias and every factor pinned to 1 has been removed --
    consume the --ds-* tokens directly instead.
  {%- endcomment -%}
  --layout-padding-factor-mobile:
  {% if mobile_mode == 'minimal' %}0{% else %}1{% endif %}; --layout-padding-factor-desktop:
  {% if desktop_mode == 'minimal' %}0{% else %}1{% endif %}; --layout-gap-grid-mobile:
  {% if mobile_mode == 'minimal' %}0{% else %}1{% endif %}; --layout-gap-grid-desktop:
  {% if desktop_mode == 'minimal' %}0{% else %}1{% endif %}; --layout-gap-swiper-mobile:
  {% if mobile_mode == 'minimal' %}0{% else %}1{% endif %}; --layout-gap-swiper-desktop:
  {% if desktop_mode == 'minimal' %}0{% else %}1{% endif %};
{%- endif -%}
