  {%- endcomment -%}
  --ds-layout-border-width-mobile: {{ layout_border_width_mobile }}px; --ds-layout-border-width-desktop:
  {{ layout_border_width_desktop }}px;

  {%- if mobile_mode == 'minimal' %}
    --ds-layout-gutter-mobile:
    {% if minimal_gutter_enabled %}{% render 'space-token', key: gutter_mobile %}{% else %}0px{% endif %};
    --ds-item-gap-mobile: {% if minimal_items_gap_enabled %}{{ items_gap_mobile }}px{% else %}0px{% endif %};
    --ds-item-radius-mobile: {% if keeps_radius_in_minimal %}{{ item_radius_mobile }}px{% else %}0px{% endif %}; --ds-layout-radius-mobile: {% if keeps_radius_in_minimal %}{{ layout_radius_mobile }}px{% else %}0px{% endif %}; --ds-item-shadow-mobile: none;
    --ds-surface-shadow-mobile: none;
  {%- else %}
    --ds-layout-gutter-mobile: {% render 'space-token', key: gutter_mobile %}; --ds-item-gap-mobile:
