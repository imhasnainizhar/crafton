{%- comment -%}
  Quote Icon

  Render contract:
  - id (String, required): unique instance id used to scope the generated CSS.
  - settings (Object, required): the caller's settings object containing the
    schema fields below. The same fields are shared by the private Quote Icon
    block and each Classic Press slide.

  Usage:
    {% render 'quote-icon', id: block.id, settings: block.settings %}

  Schema setting contract for callers:
    [
      {
        "type": "select",
        "id": "quote_face",
        "label": "Quote face",
        "options": [
          { "value": "natural", "label": "Natural" },
          { "value": "robo", "label": "Classic" }
        ],
        "default": "natural"
      },
      {
        "type": "select",
        "id": "cookie_mode",
        "label": "Quote design",
        "options": [
          { "value": "plain", "label": "Plain" },
          { "value": "pill", "label": "Pill" }
        ],
        "default": "plain"
      },
      {
        "type": "select",
        "id": "icon_size",
        "label": "Icon size",
        "options": [
          { "value": "sm", "label": "Small (16px)" },
          { "value": "md", "label": "Medium (24px)" },
          { "value": "lg", "label": "Large (32px)" },
          { "value": "xl", "label": "Extra large (40px)" }
        ],
        "default": "md"
      },
      {
        "type": "range",
        "id": "quote_icon_opacity",
        "label": "Icon opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 40
      },
      {
        "type": "range",
        "id": "quote_icon_padding",
        "label": "Pill padding (vertical)",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 8,
        "visible_if": "{{ block.settings.cookie_mode == 'cookie' }}"
      },
      {
        "type": "range",
        "id": "quote_icon_padding_inline",
        "label": "Pill padding (horizontal)",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 8,
        "visible_if": "{{ block.settings.cookie_mode == 'cookie' }}"
      },
      {
        "type": "select",
        "id": "cookie_radius_style",
        "label": "Pill corners",
        "options": [
          { "value": "round", "label": "Fully round" },
          { "value": "custom", "label": "Custom" }
        ],
        "default": "round",
        "visible_if": "{{ block.settings.cookie_mode == 'cookie' }}"
      },
      {
        "type": "range",
        "id": "cookie_border_radius",
        "label": "Custom pill radius",
        "min": 0,
        "max": 50,
        "step": 2,
        "unit": "px",
        "default": 8,
        "visible_if": "{{ block.settings.cookie_mode == 'cookie' and block.settings.cookie_radius_style == 'custom' }}"
      },
      {
        "type": "select",
        "id": "accent_selected",
        "label": "Accent",
        "options": [
          { "value": "neutral", "label": "Neutral" },
          { "value": "soft", "label": "Soft" },
          { "value": "strong", "label": "Strong" }
        ],
        "default": "neutral"
      },
      {
        "type": "select",
        "id": "accent_contrast",
        "label": "Accent Contrast",
        "info": "Pill only. Filled paints the pill with the accent; Subtle leaves it transparent.",
        "options": [
          { "value": "subtle", "label": "Subtle" },
          { "value": "filled", "label": "Filled" }
        ],
        "default": "filled",
        "visible_if": "{{ block.settings.cookie_mode == 'cookie' }}"
      }
    ]

  Notes:
  - Padding and Accent Contrast apply only when `cookie_mode` is `cookie`.
    Plain keeps the icon unpadded and always draws it in `--color-accent`.
{%- endcomment -%}

{%- liquid
  assign quote_icon_id = id | default: 'quote-icon'
  assign quote_icon_face = settings.quote_face | default: 'natural'
  assign quote_icon_design = settings.cookie_mode | default: 'classic'
  assign quote_icon_size = settings.icon_size | default: 'md'
  assign quote_icon_size_px = 24
  if quote_icon_size == 'sm'
    assign quote_icon_size_px = 16
  elsif quote_icon_size == 'lg'
    assign quote_icon_size_px = 32
  elsif quote_icon_size == 'xl'
    assign quote_icon_size_px = 40
  endif

  assign quote_icon_opacity_percent = settings.quote_icon_opacity
  if quote_icon_opacity_percent == blank
    assign quote_icon_opacity_percent = 40
  endif
  assign quote_icon_opacity = quote_icon_opacity_percent | divided_by: 100.0
  assign quote_icon_padding = settings.quote_icon_padding
  if quote_icon_padding == blank
    assign quote_icon_padding = 8
  endif
  assign quote_icon_padding_inline = settings.quote_icon_padding_inline
  if quote_icon_padding_inline == blank
    assign quote_icon_padding_inline = quote_icon_padding
  endif
  assign quote_icon_radius_style = settings.cookie_radius_style | default: 'rounded'
  assign quote_icon_border_radius = settings.cookie_border_radius | default: 8
-%}

{% style %}
  .quote-icon--{{ quote_icon_id }} {
    {% render 'accent-resolver', source: settings %}
    display: inline-block;
    flex: 0 0 auto;
    box-sizing: content-box;
    width: {{ quote_icon_size_px }}px;
    height: {{ quote_icon_size_px }}px;
    opacity: {{ quote_icon_opacity }};
    {% if quote_icon_design == 'cookie' %}
      padding: {{ quote_icon_padding }}px {{ quote_icon_padding_inline }}px;
      {% render 'accent-contrast-resolver', source: settings %}
      {% if quote_icon_radius_style == 'custom' %}
        border-radius: {{ quote_icon_border_radius }}px;
      {% else %}
        border-radius: 99999999px;
      {% endif %}
    {% else %}
      color: var(--color-accent);
    {% endif %}
  }

  .quote-icon--{{ quote_icon_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstyle %}

<svg
  class="quote-icon quote-icon--{{ quote_icon_id }}"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
>
  {% if quote_icon_face == 'robo' %}
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
  {% else %}
    <path d="M9.1 7.2C6.5 8.3 5 10.6 5 13.4c0 2.1 1.4 3.8 3.5 3.8 1.8 0 3.1-1.3 3.1-3.1 0-1.6-1-2.8-2.6-3.1.4-1.1 1.3-2 2.8-2.7L9.1 7.2Zm8 0c-2.6 1.1-4.1 3.4-4.1 6.2 0 2.1 1.4 3.8 3.5 3.8 1.8 0 3.1-1.3 3.1-3.1 0-1.6-1-2.8-2.6-3.1.4-1.1 1.3-2 2.8-2.7l-2.7-1.1Z"/>
  {% endif %}
</svg>
