{%- comment -%}
  Theme styles — the shared <head> styling of every layout: maps each color
  scheme to its --color-* roles, loads assets/base.css, then the four type
  roles, their global size / line-height / letter-spacing tokens and the
  resolved Design System (--ds-*) on :root. Rendered by layout/theme.liquid
  and layout/password.liquid, before content_for_header.
  Schema: none (reads theme settings).

  Usage:
    {% render 'theme-styles' %}
{%- endcomment -%}
{% style %}
  html {
    scrollbar-gutter: stable;
    font-size: clamp(14px, 0.5vw + 12px, 16px);
  }
  {% for scheme in settings.color_schemes %}
    .color-{{ scheme.id }} {
      /* Mappings of color scheme role to css variables tokens */
      --color-base: {{ scheme.settings.base_color }};
      --color-base-gradient: {{ scheme.settings.base_gradient }};
      --color-surface: {{ scheme.settings.surface_color }};

      --color-heading: {{ scheme.settings.heading }};
      --color-text: {{ scheme.settings.text }};
      --color-soft-text: {{ scheme.settings.soft_text }};
      --color-link: {{ scheme.settings.link_color | default: scheme.settings.neutral_accent }};

      {% comment %}
      Each accent selected by a block or section is resolved by the
      `accent-resolver.liquid` snippet to local accent variables.
      {% endcomment %}
      --color-accent-neutral: {{ scheme.settings.neutral_accent }};
      --color-accent-neutral-contrast: {{ scheme.settings.neutral_accent_contrast }};
      --color-accent-neutral-border: {{ scheme.settings.neutral_accent_border }};

      --color-accent-soft: {{ scheme.settings.soft_accent }};
      --color-accent-soft-contrast: {{ scheme.settings.soft_accent_contrast }};
      --color-accent-soft-border: {{ scheme.settings.soft_accent_border }};

      --color-accent-strong: {{ scheme.settings.strong_accent }};
      --color-accent-strong-contrast: {{ scheme.settings.strong_accent_contrast }};
      --color-accent-strong-border: {{ scheme.settings.strong_accent_border }};

      --color-border: {{ scheme.settings.border }};
      --color-border-strong: {{ scheme.settings.strong_border }};
      --color-shadow: {{ scheme.settings.shadow }};

      /* Shared neutral accent aliases for components without local selection */
      --color-accent-contrast: var(--color-accent-neutral-contrast);
      --color-accent: var(--color-accent-neutral);
      --color-accent-border: var(--color-accent-neutral-border);
    }
  {% endfor %}
{% endstyle %}

{% style %}
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 350px;
    background-color: var(--color-base);
    color: var(--color-text);
    font-family: var(--font-body-family);
    font-size: var(--fs-body);
    line-height: var(--lh-body, 1.5);
    -webkit-font-smoothing: antialiased;
  }

  img,
  svg {
    max-width: 100%;
    height: auto;
  }

  /* Utility class for screen readers */
  .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }

  .skip-to-content-link:focus {
    z-index: 9999;
    width: auto;
    height: auto;
    padding: 0.75rem 1rem;
    clip: auto;
    overflow: visible;
    background-color: var(--color-base);
    color: var(--color-heading);
  }
{% endstyle %}

{{ 'base.css' | asset_url | stylesheet_tag }}

{% style %}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_subtitle_font | font_face: font_display: 'swap' }}
  {{ settings.type_accent_font | font_face: font_display: 'swap' }}

  :root {
    --font-body-family: {{ settings.type_body_font.family | default: 'Arial' }}, {{ settings.type_body_font.fallback_families | default: 'sans-serif' }};
    --font-body-style: {{ settings.type_body_font.style | default: 'normal' }};
    --font-body-weight: {{ settings.type_body_font.weight | default: 400 }};

    --font-heading-family: {{ settings.type_heading_font.family | default: 'Arial' }}, {{ settings.type_heading_font.fallback_families | default: 'sans-serif' }};
    --font-heading-style: {{ settings.type_heading_font.style | default: 'normal' }};
    --font-heading-weight: {{ settings.type_heading_font.weight | default: 400 }};

    --font-subtitle-family: {{ settings.type_subtitle_font.family | default: 'Arial' }}, {{ settings.type_subtitle_font.fallback_families | default: 'sans-serif' }};
    --font-subtitle-style: {{ settings.type_subtitle_font.style | default: 'normal' }};
    --font-subtitle-weight: {{ settings.type_subtitle_font.weight | default: 400 }};

    --font-accent-family: {{ settings.type_accent_font.family | default: 'Arial' }}, {{ settings.type_accent_font.fallback_families | default: 'sans-serif' }};
    --font-accent-style: {{ settings.type_accent_font.style | default: 'normal' }};
    --font-accent-weight: {{ settings.type_accent_font.weight | default: 400 }};

    {%- comment -%}
      Text casing per role. Blocks pick Theme (this var) or None.
    {%- endcomment -%}
    --heading-text-transform: {{ settings.heading_casing | default: 'none' }};
    --subtitle-text-transform: {{ settings.subtitle_casing | default: 'none' }};
    --body-text-transform: {{ settings.text_casing | default: 'none' }};
    --caption-label-text-transform: {{ settings.caption_label_casing | default: 'none' }};

    {%- comment -%}
      Role size factors — global only, never overridable. They scale the
      already-clamped ladder step in assets/base.css. Accent has no factor.
    {%- endcomment -%}
    --heading-size-factor: {{ settings.heading_size_factor | default: 1 }};
    --subtitle-size-factor: {{ settings.subtitle_size_factor | default: 1 }};
    --text-size-factor: {{ settings.text_size_factor | default: 1 }};

    {%- comment -%}
      Line height — global default per role; a block may override its own.
    {%- endcomment -%}
    --lh-heading: {{ settings.heading_line_height | default: 1.2 }};
    --lh-subtitle: {{ settings.subtitle_line_height | default: 1.3 }};
    --lh-body: {{ settings.body_line_height | default: 1.5 }};

    {%- comment -%}
      Letter spacing — role based, global only. Never overridable per block.
      Stored as hundredths of an em so the range stays integer-stepped.
    {%- endcomment -%}
    --ls-heading: {{ settings.heading_letter_spacing | default: 0 | divided_by: 100.0 }}em;
    --ls-subtitle: {{ settings.subtitle_letter_spacing | default: 0 | divided_by: 100.0 }}em;
    --ls-text: {{ settings.text_letter_spacing | default: 0 | divided_by: 100.0 }}em;

    {% render 'design-system-vars', source: settings %}

    {%- comment -%}
      TV font bump: suppress in Minimal mode for truly minimal aesthetic.
      Modern mode keeps the TV bump for responsive font growth on wide displays.
    {%- endcomment -%}
    {%- assign mobile_mode = settings.design_mode_mobile | default: 'modern' %}
    {%- if mobile_mode == 'minimal' %}
      --tv-font-bump: 0px;
    {%- endif %}
  }

  @media screen and (min-width: 768px) {
    :root {
      {%- comment -%}Desktop TV font bump override for Minimal mode{%- endcomment -%}
      {%- assign desktop_mode = settings.design_mode_desktop | default: 'modern' %}
      {%- if desktop_mode == 'minimal' %}
        --tv-font-bump: 0px;
      {%- endif %}
    }
  }

  h1, h2, h3, h4, h5, h6 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: var(--lh-heading);
  }

  p {
    margin: 0;
  }

  button,
  .button,
  label {
    text-transform: var(--caption-label-text-transform);
  }
{% endstyle %}
