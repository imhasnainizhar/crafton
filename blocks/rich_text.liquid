{%- comment -%}
  Rich Text

  A single Shopify rich-text editor box rendered as `.rte` content, plus its own
  panel surface (glass/solid background, border, radius, padding).

  TYPOGRAPHY IS GLOBAL HERE. A rich-text box is one field, so there is no way to
  target an individual heading inside it from this block. Heading and text sizes
  for `.rte` content therefore come from Theme settings > Typography > Rich Text,
  which reuse the same ladders and the same Heading and Text Size Factors as the
  Heading and Text blocks. This block owns only weight, line height and casing.

  Accent typography is resolved by snippets/accent-typography.liquid: this block
  hands over its settings object, and the snippet inherits the theme Typography
  defaults unless "Use Custom Accent Typography" is checked.
{%- endcomment -%}

{%- liquid
  assign rt_selector = '.block-' | append: block.id | append: ' .rte'

  assign rt_h1 = settings.rich_text_h1_size | default: 'xxl'
  assign rt_h2 = settings.rich_text_h2_size | default: 'xl'
  assign rt_h3 = settings.rich_text_h3_size | default: 'lg'
  assign rt_h4 = settings.rich_text_h4_size | default: 'md'
  assign rt_h5 = settings.rich_text_h5_size | default: 'sm'
  assign rt_h6 = settings.rich_text_h6_size | default: 'xs'

  capture rt_bg
    render 'background-role-token', key: block.settings.background_role
  endcapture
-%}

{%- style -%}
  .block-{{ block.id }} {
    /* Layout & Alignment */
    box-sizing: border-box;
    max-width: min({{ block.settings.max_width | default: '100%' }}, 100%);
    margin: 0 auto;
    /* Contain the content: long words / URLs wrap instead of overflowing when
       truncation is off (no clipping wrapper is present in that case). */
    overflow-wrap: break-word;
    word-break: break-word;
    text-align: {{ block.settings.text_alignment }};
    padding: calc({{ block.settings.padding_vertical }}rem) calc({{ block.settings.padding_horizontal }}rem);
    

    /* Colour follows whatever scheme the section or parent block sets; this
       block only picks which background role of that scheme it paints. */
    color: var(--color-text);
    {% case block.settings.background_style %}
      {% when 'none' %}
      background-color: transparent;
      {% when 'glass' %}
      background-color: {{ rt_bg }};
      background-color: color-mix(in srgb, {{ rt_bg }} {{ block.settings.glass_tint_opacity }}%, transparent);
      -webkit-backdrop-filter: blur({{ block.settings.glass_blur }}px);
      backdrop-filter: blur({{ block.settings.glass_blur }}px);
      box-shadow: 0 8px 32px color-mix(in srgb, var(--color-shadow) {{ block.settings.glass_shadow_opacity }}%, transparent);
      {% else %}
      background-color: {{ rt_bg }};
    {% endcase %}

    /* Border Styling */
    {% if block.settings.border_enabled %}
      border: {{ block.settings.border_thickness | at_least: 1 }}px solid {% if block.settings.background_style == 'glass' %}color-mix(in srgb, var(--color-border) {{ block.settings.glass_border_opacity }}%, transparent){% else %}var(--color-border){% endif %};
    {% else %}
      border: 0;
    {% endif %}
    border-radius: var(--ds-layout-radius-mobile);

    /* Typography — role 'text'; sizes come from the global Rich Text settings. */
    {% render 'typography-resolver', role: 'text', source: block.settings %}
  }

  /* Headings inside the rich text box. One editor field cannot expose a size
     control per heading, so these come from Theme settings > Typography >
     Rich Text and use the shared heading ladder. */
  .block-{{ block.id }} .rte h1 { font-size: var(--fs-heading-{{ rt_h1 }}); }
  .block-{{ block.id }} .rte h2 { font-size: var(--fs-heading-{{ rt_h2 }}); }
  .block-{{ block.id }} .rte h3 { font-size: var(--fs-heading-{{ rt_h3 }}); }
  .block-{{ block.id }} .rte h4 { font-size: var(--fs-heading-{{ rt_h4 }}); }
  .block-{{ block.id }} .rte h5 { font-size: var(--fs-heading-{{ rt_h5 }}); }
  .block-{{ block.id }} .rte h6 { font-size: var(--fs-heading-{{ rt_h6 }}); }

  .block-{{ block.id }} .rte h1,
  .block-{{ block.id }} .rte h2,
  .block-{{ block.id }} .rte h3,
  .block-{{ block.id }} .rte h4,
  .block-{{ block.id }} .rte h5,
  .block-{{ block.id }} .rte h6 {
    font-family: var(--font-heading-family);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
    color: var(--color-heading);
  }

  /* Ensure RTE formatting inside the block doesn't override padding */
  .block-{{ block.id }} .rte {
    margin: 0;
  }

  /* Media never exceeds the box; tables/pre scroll internally rather than
     stretching the block. */
  .block-{{ block.id }} .rte img,
  .block-{{ block.id }} .rte video,
  .block-{{ block.id }} .rte iframe {
    max-width: 100%;
    height: auto;
  }

  .block-{{ block.id }} .rte table,
  .block-{{ block.id }} .rte pre {
    max-width: 100%;
    overflow-x: auto;
  }

  

  @media (min-width: 768px) {
    .block-{{ block.id }} {
      border-radius: var(--ds-layout-radius-desktop);
    }
  }
{%- endstyle -%}

{%- comment -%}
  No scheme class here: the block inherits the scheme of whatever contains it
  and only chooses which background role of that scheme it paints.
{%- endcomment -%}

<div class="block-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="rte" {% render 'accent-typography', source: block.settings, mode: 'attributes' %}>
    {% render 'truncate-text',
      id: block.id,
      content: block.settings.content,
      enable: block.settings.enable_truncate,
      lines: block.settings.truncate_lines,
      mode: block.settings.truncate_mode,
      read_more_text: block.settings.read_more_text,
      transition: block.settings.transition_duration,
      popover_title: block.settings.popover_title,
      overlay_opacity: block.settings.overlay_opacity,
      popover_color_scheme: block.settings.popover_color_scheme,
      popover_background_role: block.settings.popover_background_role,
      popover_max_height: block.settings.popover_max_height,
      popover_max_width: block.settings.popover_max_width,
      popover_animation: block.settings.popover_animation,
      popover_fade: block.settings.popover_fade,
      popover_mobile_layout: block.settings.popover_mobile_layout,
      popover_full_width_mobile: block.settings.popover_full_width_mobile,
      popover_content_alignment: block.settings.popover_content_alignment
    %}
  </div>
</div>

{% render 'accent-typography', source: block.settings, selector: rt_selector %}
