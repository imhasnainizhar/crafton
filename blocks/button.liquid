{%- comment -%}
  Button

  - Button block; a thin wrapper over snippets/button.liquid so every button in
    the theme shares one implementation.
  - The optional icon is drawn from a small set of inline SVGs, so no extra
    asset request is made.
{%- endcomment -%}

{%- liquid
  capture button_icon
    case block.settings.icon
      when 'arrow'
        echo '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7"/></svg>'
      when 'plus'
        echo '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>'
      when 'cart'
        echo '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.4L21 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>'
      when 'external'
        echo '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5"/></svg>'
      when 'custom'
        echo block.settings.custom_icon_svg
    endcase
  endcapture
-%}

{% style %}
  .button--{{ block.id }} {
    {% render 'accent-resolver', source: block.settings %}
  }
{% endstyle %}

{% render 'button',
  id: block.id,
  text: block.settings.text,
  link: block.settings.link,
  style: block.settings.style,
  size: block.settings.size,
  padding_x: block.settings.padding_x,
  padding_y: block.settings.padding_y,
  radius: block.settings.border_radius,
  uppercase: block.settings.uppercase,
  full_width: block.settings.full_width,
  icon: button_icon,
  class: 'button-block',
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "header",
      "content": "Button",
      "info": "A call-to-action button linking to any URL."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "solid",
          "label": "Solid (Primary)"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "accent_selected",
      "label": "Color scheme accent",
      "info": "Uses the selected accent from the surrounding section's color scheme.",
      "options": [
        { "value": "neutral", "label": "Neutral" },
        { "value": "soft", "label": "Soft" },
        { "value": "strong", "label": "Strong" }
      ],
      "default": "neutral"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Text Size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "body", "label": "Body" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "body"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "select",
      "id": "icon",
      "label": "SVG icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "arrow", "label": "Arrow" },
        { "value": "plus", "label": "Plus" },
        { "value": "cart", "label": "Cart" },
        { "value": "external", "label": "External link" },
        { "value": "custom", "label": "Custom SVG" }
      ],
      "default": "none"
    },
    {
      "type": "textarea",
      "id": "custom_icon_svg",
      "label": "Custom SVG icon",
      "info": "Paste a small inline SVG. Used when SVG icon is Custom SVG.",
      "visible_if": "{{ block.settings.icon == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_x",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Button"
    }
  ]
}
{% endschema %}
