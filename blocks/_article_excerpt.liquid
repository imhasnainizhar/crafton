{%- comment -%}
  Article Description — a short summary of the closest article
  (`closest.article`): its excerpt, or its opening words when it has none.
  Text-role type through snippets/typography-resolver.liquid, colour through
  snippets/color-role-resolver.liquid, an optional line clamp in CSS.
{%- endcomment -%}

{% stylesheet %}
  .art-excerpt {
    margin: 0;
    text-align: var(--text-align, left);
    overflow-wrap: anywhere;
  }

  .art-excerpt--clamp {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--art-excerpt-lines);
    line-clamp: var(--art-excerpt-lines);
    overflow: hidden;
  }
{% endstylesheet %}

{%- liquid
  assign art = closest.article
  assign words = block.settings.word_count | default: 30
  assign summary = blank
  if art != blank
    if block.settings.source == 'content' or art.excerpt == blank
      assign summary = art.content | strip_html | strip_newlines | truncatewords: words
    else
      assign summary = art.excerpt | strip_html | strip_newlines | truncatewords: words
    endif
  else
    assign summary = 'theme.components.article_card.placeholder_excerpt' | t
  endif
-%}

{%- if summary != blank -%}
  {% style %}
    .art-excerpt--{{ block.id }} {
      {% render 'typography-resolver', role: 'text', source: block.settings %}
      {% render 'color-role-resolver', mode: 'color', role: 'soft', source: block.settings %}
      {% if block.settings.max_lines > 0 %}--art-excerpt-lines: {{ block.settings.max_lines }};{% endif %}
    }
  {% endstyle %}

  <p class="art-excerpt art-excerpt--{{ block.id }}{% if block.settings.max_lines > 0 %} art-excerpt--clamp{% endif %}" {{ block.shopify_attributes }}>
    {{- summary | escape -}}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Article Description",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Article Description",
      "info": "A short summary of the article this block sits in."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Show",
      "options": [
        { "value": "excerpt", "label": "Excerpt, else the opening words" },
        { "value": "content", "label": "Opening words of the article" }
      ],
      "default": "excerpt"
    },
    {
      "type": "range",
      "id": "word_count",
      "label": "Word limit",
      "min": 5,
      "max": 80,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "max_lines",
      "label": "Maximum lines",
      "info": "Longer text ends with an ellipsis. 0 shows every line.",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Size",
      "options": [
        { "value": "xxs", "label": "Extra small" },
        { "value": "xs", "label": "Small" },
        { "value": "sm", "label": "Medium" },
        { "value": "md", "label": "Body" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "medium", "label": "Medium" },
        { "value": "semibold", "label": "Semi-bold" },
        { "value": "bold", "label": "Bold" }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "override_line_height",
      "label": "Override Theme Line Height",
      "default": false
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2.4,
      "step": 0.1,
      "default": 1.5,
      "visible_if": "{{ block.settings.override_line_height }}"
    },
    {
      "type": "select",
      "id": "text_casing",
      "label": "Text Casing",
      "info": "On None, the text renders exactly as typed.",
      "options": [
        { "value": "theme", "label": "Theme" },
        { "value": "none", "label": "None" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Color",
      "info": "Automatic follows this block's own role, so a card set to Accent recolors it.",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "heading", "label": "Heading" },
        { "value": "text", "label": "Text" },
        { "value": "soft", "label": "Soft Text" },
        { "value": "accent", "label": "Accent" },
        { "value": "parent", "label": "Inherit From Parent" }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "Article Description"
    }
  ]
}
{% endschema %}
