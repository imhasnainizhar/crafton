{%- comment -%}
  Blog Description — a line or two about the closest blog (`closest.blog`).
  Shopify blogs have no description field, so the text is the merchant's own,
  or the summary of the blog's latest post. Text-role type through
  snippets/typography-resolver.liquid, colour through
  snippets/color-role-resolver.liquid, an optional line clamp in CSS.
{%- endcomment -%}

{% stylesheet %}
  .blg-desc {
    margin: 0;
    text-align: var(--text-align, left);
    overflow-wrap: anywhere;
  }

  .blg-desc--clamp {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--blg-desc-lines);
    line-clamp: var(--blg-desc-lines);
    overflow: hidden;
  }
{% endstylesheet %}

{%- liquid
  assign bl = closest.blog
  assign desc = blank
  if block.settings.source == 'latest'
    assign latest = bl.articles.first
    if latest.excerpt != blank
      assign desc = latest.excerpt | strip_html | strip_newlines | truncatewords: block.settings.word_count
    elsif latest != blank
      assign desc = latest.content | strip_html | strip_newlines | truncatewords: block.settings.word_count
    endif
  else
    assign desc = block.settings.text | strip_html
  endif
  if desc == blank and bl == blank
    assign desc = 'theme.components.blog_card.placeholder_description' | t
  endif
-%}

{%- if desc != blank -%}
  {% style %}
    .blg-desc--{{ block.id }} {
      {% render 'typography-resolver', role: 'text', source: block.settings %}
      {% render 'color-role-resolver', mode: 'color', role: 'soft', source: block.settings %}
      {% if block.settings.max_lines > 0 %}--blg-desc-lines: {{ block.settings.max_lines }};{% endif %}
    }
  {% endstyle %}

  <p class="blg-desc blg-desc--{{ block.id }}{% if block.settings.max_lines > 0 %} blg-desc--clamp{% endif %}" {{ block.shopify_attributes }}>
    {{- desc | escape -}}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Blog Description",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Blog Description",
      "info": "Shopify blogs have no description of their own, so write one here or show the latest post's summary."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Show",
      "options": [
        { "value": "custom", "label": "My own text" },
        { "value": "latest", "label": "Latest post's summary" }
      ],
      "default": "custom"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Stories, guides and news from our team.",
      "visible_if": "{{ block.settings.source != 'latest' }}"
    },
    {
      "type": "range",
      "id": "word_count",
      "label": "Word limit",
      "min": 5,
      "max": 60,
      "step": 5,
      "default": 20,
      "visible_if": "{{ block.settings.source == 'latest' }}"
    },
    {
      "type": "range",
      "id": "max_lines",
      "label": "Maximum lines",
      "info": "Longer text ends with an ellipsis. 0 shows every line.",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Size",
      "options": [
        { "value": "xxs", "label": "Extra small" },
        { "value": "xs", "label": "Small" },
        { "value": "sm", "label": "Medium" },
        { "value": "md", "label": "Body" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "medium", "label": "Medium" },
        { "value": "semibold", "label": "Semi-bold" },
        { "value": "bold", "label": "Bold" }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "override_line_height",
      "label": "Override Theme Line Height",
      "default": false
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2.4,
      "step": 0.1,
      "default": 1.5,
      "visible_if": "{{ block.settings.override_line_height }}"
    },
    {
      "type": "select",
      "id": "text_casing",
      "label": "Text Casing",
      "info": "On None, the text renders exactly as typed.",
      "options": [
        { "value": "theme", "label": "Theme" },
        { "value": "none", "label": "None" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Color",
      "info": "Automatic follows this block's own role, so a card set to Accent recolors it.",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "heading", "label": "Heading" },
        { "value": "text", "label": "Text" },
        { "value": "soft", "label": "Soft Text" },
        { "value": "accent", "label": "Accent" },
        { "value": "parent", "label": "Inherit From Parent" }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "Blog Description"
    }
  ]
}
{% endschema %}
