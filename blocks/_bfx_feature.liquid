{%- comment -%}
  FEATURED BLOGS — Featured Blogs block (`bfx-`).
  Blog Card children beside a hero, laid out by this block. It is the
  Featured Collections (`ffx-`) block with the collection cards swapped for
  blog cards, so the stage reads the same: grid or carousel per
  breakpoint, the carousel style, the shapes, the overlap and the View all
  tile. The section around it is only a shell.

  STAGE. Two columns: `.bfx-lead` (the hero — a picture, or a Classic panel,
  plus an empty content box) and `.bfx-items` (the cards). With
  "Content over hero" on, the controller moves the Rich Content placed right
  before this block into that box, where hero_content_x / hero_content_y place
  it. A phone always stacks the columns. On a desktop carousel the style
  decides:
    classic → stacked, both carousel ends free to bleed;
    flyover → side by side, swiped cards pass OVER the hero (the only style
              where "Hero overlapping" applies);
    tunnel  → side by side, swiped cards pass UNDER the hero and are cut at its
              outer edge, so they never reappear on the far side; the hero
              column is an opaque cover the full height of the row.
  Hero right mirrors the row, the cut side, the fade side and — through
  `data-bfx-mirror` — the swipe direction.

  CLIPPING. The carousel viewport never overflow-clips; `carousel_bleed` cuts
  it with a `clip-path` (open vertically so hover lift and shadows escape):
  off, at the content edge; on, not at all, so cards run to the screen edge
  where the section shell clips them. Tunnel adds one more `clip-path` on the
  stage, cutting the hero side at the hero's outer edge.

  CARDS are this block's Blog Card children (blocks/blog_cover_card.liquid),
  emitted straight into the track by `content_for 'blocks'`, so every rule
  targets `.bfx-track > *` and the controller tags each child as a Swiper
  slide. Each card owns its look (flow or overlay, surface, colours); this
  block publishes only --bcc-ratio, the picture shape every card set to
  "Follow the section" takes, which "Match blog picture height" reads too.

  EDGE FADE sits OUTSIDE the items box, in the strip between the content edge
  and the screen edge, so a card at rest is never faded. Its width is that
  strip, measured by the controller into --bfx-edge-start / --bfx-edge-end.

  Depends on: blocks/blog_cover_card.liquid, snippets/fluid-clamp.liquid,
  snippets/motion-reveal.liquid, and the section's assets
  (swiper-bundle, blogs-featured.js).
{%- endcomment -%}

{%- liquid
  assign s = block.settings
  assign sec = section.settings
  assign anim = section.settings

  assign carousel_m = false
  if s.layout_mobile == 'carousel'
    assign carousel_m = true
  endif
  assign carousel_d = false
  if s.layout_desktop == 'carousel'
    assign carousel_d = true
  endif

  # Hero: off, a Media card, or a Classic text panel.
  assign hero_on = s.hero_enabled
  assign media_on = false
  assign panel_on = false
  if hero_on
    if s.hero_variant == 'classic'
      assign panel_on = true
    else
      assign media_on = true
    endif
  endif
  # Where the hero's Rich Content sits over the picture.
  assign hero_x = 'flex-start'
  if s.hero_content_x == 'center'
    assign hero_x = 'center'
  endif
  case s.hero_content_y
    when 'top'
      assign hero_y = 'flex-start'
    when 'center'
      assign hero_y = 'center'
    else
      assign hero_y = 'flex-end'
  endcase

  # Carousel style. Flyover and Tunnel only lay out side by side on a desktop
  # carousel; everywhere else the stage stacks.
  assign style = 'classic'
  if hero_on
    assign style = s.carousel_style
  endif
  assign side = false
  if carousel_d and style != 'classic'
    assign side = true
  endif
  assign hero_end = false
  if side and s.hero_position == 'right'
    assign hero_end = true
  endif

  assign overlap_m = 0
  if carousel_m and style == 'flyover'
    assign overlap_m = s.carousel_overlap_mobile
  endif
  assign overlap_d = 0
  if side and style == 'flyover'
    assign overlap_d = s.carousel_overlap_desktop
  endif


  # Beside a Flyover / Tunnel carousel the hero takes its own, taller shapes.
  assign hero_ratio_d = s.hero_ratio_desktop
  if side
    assign hero_ratio_d = s.hero_ratio_side
  endif

  # Fixed hero width is one fluid clamp, linearly interpolated between the
  # mobile and desktop px widths (it only applies beside a Flyover / Tunnel
  # carousel, i.e. on desktop).
  if s.hero_width_mode == 'fixed'
    capture hero_w
      render 'fluid-clamp', min: s.hero_width_px_mobile, max: s.hero_width_px
    endcapture
    assign hero_w = hero_w | strip
  else
    assign hero_w = s.hero_width_desktop | append: '%'
  endif

  # Stage clip, as clip-path insets. -100vw leaves a side to the section
  # shell (the screen edge); 0 cuts it at the stage.
  assign clip_l = '-100vw'
  assign clip_r = '-100vw'
  if side and style == 'tunnel'
    if hero_end
      assign clip_r = '0'
    else
      assign clip_l = '0'
    endif
  endif
  assign clip_d = blank
  if clip_l != '-100vw' or clip_r != '-100vw'
    assign clip_d = 'inset(-100vh ' | append: clip_r | append: ' -100vh ' | append: clip_l | append: ')'
  endif

  # Full-width hero: only the hero leaves the section rail, and only in the
  # stacked layouts (a grid or a Classic carousel) — never beside a Flyover /
  # Tunnel carousel. Content and cards keep the rail.
  # Slide size: one fluid width (default), or a number of slides per view —
  # one pair for a Classic carousel, another for Flyover / Tunnel. A count is
  # turned into a width in CSS, from the carousel column's width in container
  # units: the whole stage when stacked, the stage less the hero column and
  # the gap (plus any Flyover overlap) side by side.
  assign spv_on = false
  if s.slide_sizing == 'count'
    assign spv_on = true
    if style == 'classic'
      assign spv_m = s.slides_per_view_mobile
      assign spv_d = s.slides_per_view_desktop
    else
      assign spv_m = s.slides_per_view_side_mobile
      assign spv_d = s.slides_per_view_side_desktop
    endif
    assign spv_gaps_m = spv_m | minus: 1
    assign spv_gaps_d = spv_d | minus: 1
    if s.hero_width_mode == 'fixed'
      assign spv_hero_w = 'var(--bfx-hero-width)'
    else
      assign spv_hero_w = s.hero_width_desktop | append: 'cqw'
    endif
  endif
  # Carousel bleed decides where cards stop, as a clip-path on the viewport:
  #   cut  (bleed off) → at the content edge;
  #   open (bleed on)  → no clip, cards run on to the screen edge.
  # Side by side, the hero side is never cut here: it keeps its Flyover /
  # Tunnel behaviour (Tunnel's cut is the stage / panel clip above).
  assign bleed_mode = 'cut'
  if s.carousel_bleed
    assign bleed_mode = 'open'
  endif
  assign cut_l_d = '0'
  assign cut_r_d = '0'
  if side
    if hero_end
      assign cut_r_d = '-100vw'
    else
      assign cut_l_d = '-100vw'
    endif
  endif
  # Hero matches the blog card picture height: a card is its width x its ratio,
  # so the height is computed in CSS from the slide width (carousel) or the
  # column width (grid), per breakpoint.
  assign hero_match = false
  if hero_on and s.hero_match_cards
    assign hero_match = true
  endif
  assign hero_full = false
  if s.full_width and hero_on and side == false
    assign hero_full = true
  endif

  assign fade_on = false
  if s.edge_fade and s.carousel_bleed
    if carousel_m or carousel_d
      assign fade_on = true
    endif
  endif

  # One fluid slide width, interpolated between the two breakpoint widths.
  capture slide_w
    render 'fluid-clamp', min: s.slide_width_mobile, max: s.slide_width_desktop
  endcapture

  # One picture shape for every card set to "Follow the section" (--bcc-ratio).
  assign card_ratio_m = s.card_ratio_mobile | default: '4/5'
  assign card_ratio_d = s.card_ratio_desktop | default: '4/5'

  assign hero_content = false
  if hero_on and s.content_over_hero
    assign hero_content = true
  endif


  assign more_btn_class = 'bfx-more__btn'
  if sec.more_variant == 'text'
    assign more_btn_class = more_btn_class | append: ' bfx-more__btn--text'
    if sec.more_underline
      assign more_btn_class = more_btn_class | append: ' bfx-more__btn--underline'
    endif
  endif

-%}

{% style %}
  .bfx-stage--{{ block.id }} {
    --bfx-overlap: {{ overlap_m }}px;
    --bfx-hero-width: {{ hero_w }};
    --bfx-scrim: {{ s.hero_scrim }};
    --bfx-columns: {{ s.grid_columns_mobile }};
    --bcc-ratio: {{ card_ratio_m }};
    {% if spv_on %}
      --bfx-slide-w: calc((100cqw - {{ spv_gaps_m }} * var(--ds-item-gap-mobile)) / {{ spv_m }});
    {% else %}
      --bfx-slide-w: {{ slide_w | strip }};
    {% endif %}
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--ds-layout-gap-mobile);
  }

  {% if hero_full %}
    /* Full-width hero: the hero alone steps out of the section rail — negative
       inline margins only — with square corners. */
    .bfx-stage--{{ block.id }} .bfx-lead {
      margin-inline: calc(-1 * var(--ds-layout-gutter-mobile));
    }
  {% endif %}

  /* ---------------------------------------------------------------- lead */

  .bfx-stage--{{ block.id }} .bfx-lead {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--ds-layout-gap-mobile);
    min-width: 0;
  }

  /* The hero box holds the picture, its overlay and the Rich Content laid
     over it, and carries the corners so the overlay follows them. */
  /* Opaque ground behind the picture, so a placeholder or a video that has not
     painted yet never lets a Tunnel card show through. */
  .bfx-stage--{{ block.id }} .bfx-herobox {
    position: relative;
    overflow: hidden;
    border-radius: {% if hero_full %}0{% else %}var(--ds-layout-radius-mobile){% endif %};
    background-color: var(--color-surface);
  }

  .bfx-stage--{{ block.id }} .bfx-hero__media {
    position: relative;
    overflow: hidden;
    {% if s.hero_ratio_mobile != 'auto' %}aspect-ratio: {{ s.hero_ratio_mobile }};{% endif %}
  }

  .bfx-stage--{{ block.id }} .bfx-hero__image {
    display: block;
    width: 100%;
    height: {% if s.hero_ratio_mobile != 'auto' %}100%{% else %}auto{% endif %};
    object-fit: cover;
  }

  .bfx-stage--{{ block.id }} .bfx-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-color: color-mix(in srgb, var(--color-shadow) calc(var(--bfx-scrim) * 1%), transparent);
  }

  /* Rich Content over the picture (moved in by the controller when "Content
     over hero" is on): placed by the hero content position; its width, text
     alignment and surface are its own settings. */
  .bfx-stage--{{ block.id }} .bfx-hero__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ hero_x }};
    justify-content: {{ hero_y }};
    padding: clamp(1rem, 4vw, 2.5rem);
    pointer-events: none;
  }

  .bfx-stage--{{ block.id }} .bfx-hero__content > * {
    max-width: 100%;
    pointer-events: auto;
  }

  .bfx-stage--{{ block.id }} .bfx-hero__content:empty { display: none; }

  {% if panel_on %}
    /* Classic hero: the Rich Content on a plain panel in the section's base
       colour — opaque, so a Tunnel carousel disappears behind it. */
    .bfx-stage--{{ block.id }} .bfx-herobox {
      background-color: var(--color-base);
      {% if s.hero_border %}border: var(--ds-layout-border-width-mobile, 1px) solid var(--color-border);{% endif %}
    }

    .bfx-stage--{{ block.id }} .bfx-hero,
    .bfx-stage--{{ block.id }} .bfx-hero__scrim { display: none; }

    .bfx-stage--{{ block.id }} .bfx-hero__content { position: static; }
  {% endif %}

  /* --------------------------------------------------------------- items */

  .bfx-stage--{{ block.id }} .bfx-items {
    position: relative;
    /* Flyover is the one style that passes over the hero; every other style
       keeps the hero on top, which is what hides a Tunnel card. */
    z-index: {% if style == 'flyover' %}3{% else %}1{% endif %};
    min-width: 0;
    margin-top: calc(-1 * var(--bfx-overlap));
  }

  .bfx-stage--{{ block.id }} .bfx-items__viewport {
    /* One axis only: a blanket overflow:hidden would clip card hover lift and
       shadow along with the track. */
    overflow-x: clip;
    overflow-y: visible;
  }

  /* A mirrored carousel runs right to left; its cards still read left to right. */
  .bfx-stage--{{ block.id }} .bfx-items__viewport[dir='rtl'] .bfx-track > * { direction: ltr; }

  /* Static (uninitialized) layout is a real grid, with Swiper's own slide
     sizing neutralised. Swiper owns the box only once it initializes. */
  .bfx-stage--{{ block.id }} .bfx-items__viewport:not(.swiper-initialized) .bfx-track {
    display: grid;
    grid-template-columns: repeat(var(--bfx-columns), minmax(0, 1fr));
    gap: var(--ds-item-gap-mobile);
    transition-property: none;
  }

  .bfx-stage--{{ block.id }} .bfx-track > * {
    box-sizing: border-box;
    min-width: 0;
  }

  .bfx-stage--{{ block.id }} .bfx-items__viewport:not(.swiper-initialized) .bfx-track > * {
    width: auto;
  }


  /* A carousel slide is one fluid width (Swiper runs slidesPerView: auto). */
  .bfx-stage--{{ block.id }} .bfx-items__viewport.swiper-initialized .bfx-track > * {
    width: var(--bfx-slide-w);
    height: auto;
  }

  /* Edge fades live outside the items box, in the strip up to the screen edge. */
  .bfx-stage--{{ block.id }} .bfx-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 4;
    display: none;
    pointer-events: none;
  }

  .bfx-stage--{{ block.id }} .bfx-fade--start {
    right: 100%;
    width: var(--bfx-edge-start, var(--ds-layout-gutter-mobile));
    background: linear-gradient(to left, transparent, var(--color-base));
  }

  .bfx-stage--{{ block.id }} .bfx-fade--end {
    left: 100%;
    width: var(--bfx-edge-end, var(--ds-layout-gutter-mobile));
    background: linear-gradient(to right, transparent, var(--color-base));
  }

  /* ------------------------------------------------------------ view all */

  /* The View all link is the track's last cell. In a carousel that makes it the tile
     after the final card; in a grid the track IS a grid, so it spans every
     column as a centred row under the cards. One position, both layouts. */
  .bfx-stage--{{ block.id }} .bfx-more {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* In a carousel the tile is as tall as the cards, so the link sits centred
     on both axes. */
  .bfx-stage--{{ block.id }} .bfx-items__viewport.swiper-initialized .bfx-more {
    height: auto;
    align-self: stretch;
  }

  .bfx-stage--{{ block.id }} .bfx-items__viewport:not(.swiper-initialized) .bfx-more {
    grid-column: 1 / -1;
    justify-self: center;
    margin-top: var(--ds-layout-gap-mobile);
  }

  .bfx-stage--{{ block.id }} .bfx-more__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    border: 1px solid var(--color-button-border, var(--color-border));
    border-radius: 999px;
    background-color: var(--color-button, transparent);
    color: var(--color-button-text, var(--color-text));
    font-size: var(--fs-text-sm);
    cursor: pointer;
    text-decoration: none;
  }

  .bfx-stage--{{ block.id }} .bfx-more__btn--text {
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: var(--color-text);
  }

  .bfx-stage--{{ block.id }} .bfx-more__btn--underline {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

    /* Stage and cards enter with the section's motion (snippets/motion-reveal). */
    .bfx-stage--{{ block.id }} {
      {% render 'motion-reveal', part: 'vars', from: anim %}
    }

  /* ------------------------------------------------ mobile-only carousel */

  @media (max-width: 767.98px) {
    {% if carousel_m %}
      /* The viewport never overflow-clips a carousel; bleed cuts it with a
         clip-path, open vertically so hover lift and shadows escape. */
      .bfx-stage--{{ block.id }} .bfx-items__viewport { overflow: visible; }
      {% if bleed_mode == 'cut' %}
        .bfx-stage--{{ block.id }} .bfx-items__viewport { clip-path: inset(-100vh 0px -100vh 0px); }
      {% endif %}
      {% if fade_on %}
        .bfx-stage--{{ block.id }} .bfx-fade { display: block; }
      {% endif %}
    {% endif %}
  }

  /* ------------------------------------------------------------- desktop */

  @media (min-width: 768px) {
    .bfx-stage--{{ block.id }} {
      --bfx-overlap: {{ overlap_d }}px;
      --bfx-columns: {{ s.grid_columns_desktop }};
      --bcc-ratio: {{ card_ratio_d }};
      gap: var(--ds-layout-gap-desktop);
    }

    {% if hero_full %}
      .bfx-stage--{{ block.id }} .bfx-lead {
        margin-inline: calc(-1 * var(--ds-layout-gutter-desktop));
      }
    {% endif %}

    .bfx-stage--{{ block.id }} .bfx-lead { gap: var(--ds-layout-gap-desktop); }

    .bfx-stage--{{ block.id }} .bfx-herobox {
      {% unless hero_full %}border-radius: var(--ds-layout-radius-desktop);{% endunless %}
      {% if panel_on and s.hero_border %}border-width: var(--ds-layout-border-width-desktop, 1px);{% endif %}
    }

    .bfx-stage--{{ block.id }} .bfx-hero__media {
      {% if hero_ratio_d != 'auto' %}
        aspect-ratio: {{ hero_ratio_d }};
      {% elsif s.hero_ratio_mobile != 'auto' %}
        aspect-ratio: auto;
      {% endif %}
    }

    .bfx-stage--{{ block.id }} .bfx-hero__image {
      height: {% if hero_ratio_d != 'auto' %}100%{% else %}auto{% endif %};
    }

    .bfx-stage--{{ block.id }} .bfx-items__viewport:not(.swiper-initialized) .bfx-track {
      gap: var(--ds-item-gap-desktop);
    }


    .bfx-stage--{{ block.id }} .bfx-items__viewport:not(.swiper-initialized) .bfx-more {
      margin-top: var(--ds-layout-gap-desktop);
    }

    .bfx-stage--{{ block.id }} .bfx-fade--start { width: var(--bfx-edge-start, var(--ds-layout-gutter-desktop)); }
    .bfx-stage--{{ block.id }} .bfx-fade--end { width: var(--bfx-edge-end, var(--ds-layout-gutter-desktop)); }

    {% if carousel_d %}
      .bfx-stage--{{ block.id }} .bfx-items__viewport { overflow: visible; }
      {% if bleed_mode == 'cut' %}
        .bfx-stage--{{ block.id }} .bfx-items__viewport { clip-path: inset(-100vh {{ cut_r_d }} -100vh {{ cut_l_d }}); }
      {% endif %}
      {% if clip_d != blank %}
        .bfx-stage--{{ block.id }} { clip-path: {{ clip_d }}; }
      {% endif %}
      {% if fade_on %}
        {% if side == false %}
          .bfx-stage--{{ block.id }} .bfx-fade { display: block; }
        {% elsif hero_end %}
          .bfx-stage--{{ block.id }} .bfx-fade--start { display: block; }
        {% else %}
          .bfx-stage--{{ block.id }} .bfx-fade--end { display: block; }
        {% endif %}
      {% endif %}
    {% endif %}

    {% if side %}
      .bfx-stage--{{ block.id }} {
        flex-direction: {% if hero_end %}row-reverse{% else %}row{% endif %};
        align-items: center;
      }

      .bfx-stage--{{ block.id }} .bfx-lead {
        flex: 0 0 var(--bfx-hero-width);
        max-width: 100%;
      }

      {% if style == 'tunnel' %}
        /* Tunnel: the whole hero column is the tunnel mouth — an opaque cover
           as tall as the row, the hero centred in it — so cards passing under
           never show above, below or around the picture. */
        .bfx-stage--{{ block.id }} .bfx-lead {
          align-self: stretch;
          justify-content: center;
          background-color: var(--color-base);
        }
      {% endif %}

      .bfx-stage--{{ block.id }} .bfx-items {
        flex: 1 1 0;
        margin-top: 0;
        {% if hero_end %}
          margin-right: calc(-1 * var(--bfx-overlap));
        {% else %}
          margin-left: calc(-1 * var(--bfx-overlap));
        {% endif %}
      }
    {% endif %}
  }
  {% if spv_on or hero_match %}
    /* Width container: slides per view and the matched hero height are both
       measured from this box's own width, in container units. */
    .bfx-stage--{{ block.id }} { container-type: inline-size; }
  {% endif %}

  {% if spv_on %}
    @media (min-width: 768px) {
      .bfx-stage--{{ block.id }} {
        {% if side %}
          --bfx-slide-w: calc((100cqw - {{ spv_hero_w }} - var(--ds-layout-gap-desktop) + var(--bfx-overlap) - {{ spv_gaps_d }} * var(--ds-item-gap-desktop)) / {{ spv_d }});
        {% else %}
          --bfx-slide-w: calc((100cqw - {{ spv_gaps_d }} * var(--ds-item-gap-desktop)) / {{ spv_d }});
        {% endif %}
      }
    }
  {% endif %}

  {% if hero_match %}
    /* Hero matches the blog card height, at every screen size. A card is
       its width x its shape, so the height is that same sum: the slide width
       in a carousel, the column width (from the stage's own width, through
       container units) in a grid. It replaces the picture shape. */
    .bfx-stage--{{ block.id }} {
      --bfx-card-h: {% if carousel_m %}calc(var(--bfx-slide-w) / (var(--bcc-ratio))){% else %}calc((100cqw - (var(--bfx-columns) - 1) * var(--ds-item-gap-mobile)) / var(--bfx-columns) / (var(--bcc-ratio))){% endif %};
    }

    .bfx-stage--{{ block.id }} .bfx-hero__media {
      aspect-ratio: auto;
      height: var(--bfx-card-h);
    }

    .bfx-stage--{{ block.id }} .bfx-hero__image { height: 100%; }

    {% if panel_on %}
      .bfx-stage--{{ block.id }} .bfx-herobox { min-height: var(--bfx-card-h); }
    {% endif %}

    @media (min-width: 768px) {
      .bfx-stage--{{ block.id }} {
        --bfx-card-h: {% if carousel_d %}calc(var(--bfx-slide-w) / (var(--bcc-ratio))){% else %}calc((100cqw - (var(--bfx-columns) - 1) * var(--ds-item-gap-desktop)) / var(--bfx-columns) / (var(--bcc-ratio))){% endif %};
      }
    }
  {% endif %}
{% endstyle %}

<div
  class="bfx-stage bfx-stage--{{ block.id }} {% render 'motion-reveal', part: 'class', from: anim %} bfx-stage--{{ style }}{% if side %} bfx-stage--side{% endif %}{% unless hero_on %} bfx-stage--no-hero{% endunless %}{% if hero_full %} bfx-stage--hero-full{% endif %}"
  data-bfx-stage
  data-bfx-panel="{{ block.id }}"
  data-bfx-layout-mobile="{{ s.layout_mobile }}"
  data-bfx-layout-desktop="{{ s.layout_desktop }}"
  {% if hero_content %}data-bfx-hero-content{% endif %}
  {% if side and hero_end %}data-bfx-mirror{% endif %}
  {{ block.shopify_attributes }}
>
  {%- if hero_on -%}
    <div class="bfx-lead">
      <div class="bfx-herobox">
        {%- if media_on -%}
          <div class="bfx-hero">
            <div class="bfx-hero__media">
              {%- if s.hero_media == 'video' and s.hero_video != blank -%}
                {{
                  s.hero_video
                  | video_tag: class: 'bfx-hero__image', image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false
                }}
              {%- elsif s.hero_image != blank -%}
                {{
                  s.hero_image
                  | image_url: width: 2000
                  | image_tag: class: 'bfx-hero__image', loading: 'lazy', sizes: '100vw', widths: '400,600,800,1200,1600,2000', alt: s.hero_image.alt
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'bfx-hero__image bfx-hero__image--placeholder' }}
              {%- endif -%}
            </div>
          </div>
          <div class="bfx-hero__scrim" aria-hidden="true"></div>
        {%- endif -%}
        {%- comment -%}
          Filled by the controller with the Rich Content placed right before
          this block, when "Content over hero" is on.
        {%- endcomment -%}
        <div class="bfx-hero__content" data-bfx-herocontent></div>
      </div>
    </div>
  {%- endif -%}

  <div
    class="bfx-items"
    data-bfx-items
  >
    {%- if fade_on -%}
      <span class="bfx-fade bfx-fade--start" aria-hidden="true"></span>
      <span class="bfx-fade bfx-fade--end" aria-hidden="true"></span>
    {%- endif -%}

    <div class="bfx-items__viewport swiper" data-bfx-viewport>
      <div
        class="bfx-track swiper-wrapper {% render 'motion-reveal', part: 'class', from: anim, group: true %}"
        id="bfx-track-{{ block.id }}"
        data-bfx-track
      >
        {%- comment -%}
          Blog Card children land here directly; the controller tags
          each one as a slide.
        {%- endcomment -%}
        {% content_for 'blocks' %}

        {%- comment -%}
          The View all link is the track's last cell, so ONE position is right
          in both layouts: a tile after the final card in a carousel, a centred
          row under a grid. It carries data-bfx-more-wrap, so it is never
          mistaken for a card.
        {%- endcomment -%}
        {%- if sec.more_label != blank and sec.more_link != blank -%}
          <div class="bfx-more" data-bfx-more-wrap>
            <a class="{{ more_btn_class }}" href="{{ sec.more_link }}">{{ sec.more_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

