        },
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        },
        {
          "value": "xl",
          "label": "XL"
        },
        {
          "value": "2xl",
