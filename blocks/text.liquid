        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "theme"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "checkbox",
      "id": "alignment_inherit",
      "label": "Inherit Alignment",
      "info": "Recommended. Follows the alignment set by the parent layout.",
      "default": true
    },
    {
      "type": "text_alignment",
      "id": "alignment",
