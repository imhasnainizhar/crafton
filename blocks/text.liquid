{%- comment -%}
  Text

  - The theme's single text block; a thin wrapper over snippets/text.liquid.
  - Replaces the retired `label` and `name` blocks: its size ladder starts at
    caption size and Fit Content gives the intrinsic width those blocks had.
  - Typography is resolved by snippets/typography-resolver.liquid (role 'text').
  - Alignment inherits from the parent layout by default; the override pins it
    left, center, or right.
{%- endcomment -%}

{%- liquid
  assign paragraph_alignment = 'inherit'
  assign paragraph_flex_alignment = 'inherit'
  unless block.settings.alignment_inherit
    assign paragraph_alignment = block.settings.alignment | default: 'left'
    assign paragraph_flex_alignment = 'flex-start'
    if paragraph_alignment == 'center'
      assign paragraph_flex_alignment = 'center'
    elsif paragraph_alignment == 'right'
      assign paragraph_flex_alignment = 'flex-end'
    endif
  endunless
-%}

<div style="--align-x: {{ paragraph_flex_alignment }}; --text-align: {{ paragraph_alignment }};" {{ block.shopify_attributes }}>
  {% render 'text',
    id: block.id,
    content: block.settings.paragraph_text,
    source: block.settings,
    max_width: block.settings.max_width,
    space_top: block.settings.space_top,
    space_bottom: block.settings.space_bottom,
    enable_truncate: block.settings.enable_truncate,
    truncate_lines: block.settings.truncate_lines,
    truncate_mode: block.settings.truncate_mode,
    read_more_text: block.settings.read_more_text,
    transition_duration: block.settings.transition_duration,
    popover_title: block.settings.popover_title,
    overlay_opacity: block.settings.overlay_opacity,
    popover_color_scheme: block.settings.popover_color_scheme,
    popover_background_role: block.settings.popover_background_role,
    popover_max_height: block.settings.popover_max_height,
    popover_max_width: block.settings.popover_max_width,
    popover_animation: block.settings.popover_animation,
    popover_fade: block.settings.popover_fade,
    popover_mobile_layout: block.settings.popover_mobile_layout,
    popover_full_width_mobile: block.settings.popover_full_width_mobile,
    popover_content_alignment: block.settings.popover_content_alignment
  %}
</div>

{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "header",
      "content": "Text",
      "info": "A block of text using the theme's Text typography role. Use it for body copy, captions, labels and short names alike."
    },
    {
      "type": "richtext",
      "id": "paragraph_text",
      "label": "Paragraph",
      "default": "<p>This is a custom paragraph snippet utilizing a CSS variable for its font size.</p>"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Color",
      "info": "Automatic follows this block's own role, so a card set to Accent recolors it.",
      "options": [
        {
          "value": "auto",
          "label": "Automatic"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "soft",
          "label": "Soft Text"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "parent",
          "label": "Inherit From Parent"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Size",
      "info": "Approximate sizes are shown at Size Factor 1.",
      "options": [
        {
          "value": "xxs",
          "label": "XXS (~11px)"
        },
        {
          "value": "xs",
          "label": "XS (~12px)"
        },
        {
          "value": "sm",
          "label": "SM (~14px)"
        },
        {
          "value": "md",
          "label": "MD (~16px)"
        },
        {
          "value": "lg",
          "label": "LG (~18px)"
        },
        {
          "value": "xl",
          "label": "XL (~24px)"
        },
        {
          "value": "xxl",
          "label": "XXL (~32px)"
        }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "semibold",
          "label": "Semi-bold"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "override_line_height",
      "label": "Override Theme Line Height",
      "default": false
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2.4,
      "step": 0.1,
      "default": 1.5,
      "visible_if": "{{ block.settings.override_line_height }}"
    },
    {
      "type": "select",
      "id": "text_casing",
