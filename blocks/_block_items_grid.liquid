{%- comment -%}
  Block Items Grid (private)

  - Grid layout that arranges Block Item blocks into columns, with optional
    dividers between them and an outer border.
  - Column count, divider style, and border are all set separately for mobile
    and desktop.
  - Column selects arrive as strings, so they are cast to numbers before the
    nth-child math that places the dividers.
{%- endcomment -%}

{%- liquid
  # Column selects are strings — cast so the nth-child math below works.
  assign cols_d = block.settings.columns_desktop | plus: 0
  assign cols_m = block.settings.columns_mobile | plus: 0
  assign divider_length_m = '100%'
  assign divider_length_d = '100%'
  if block.settings.divider_variant_mobile == 'partial'
    assign divider_length_m = block.settings.divider_length | append: '%'
  endif
  if block.settings.divider_variant_desktop == 'partial'
    assign divider_length_d = block.settings.divider_length | append: '%'
  endif

  assign grid_border_m = false
  assign grid_border_d = false
  if block.settings.grid_border_mobile == 'enabled'
    assign grid_border_m = true
  endif
  if block.settings.grid_border_desktop == 'enabled'
    assign grid_border_d = true
  endif

  # Entrance: the host section's Animations group (Block Items Grid, Stats
  # Grid, Comparison Editorial) staggers the items (snippets/motion-reveal).
  assign anim = section.settings
-%}

<script src="{{ 'stats-counter.js' | asset_url }}" type="module"></script>
<script src="{{ 'container-carousel.js' | asset_url }}" type="module"></script>

{% style %}
  {%- comment -%}
    Structure: outer (full width) → wrapper (optional border/radius box) →
    <stats-counter> row → stats items. The carousel is one flex row. Dividers
    sit halfway across Swiper's responsive gap between consecutive items.
    Divider and border color come from the active scheme's --color-border role.
  {%- endcomment -%}
  .big-outer--{{ block.id }} {
    --body-text-transform: var(--caption-label-text-transform);
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .big-wrapper--{{ block.id }} {
    width: 100%;
    box-sizing: border-box;
    border-radius: var(--ds-layout-radius-mobile);
    border: {% if grid_border_m %}{{ block.settings.border_width }}px solid var(--color-border){% else %}0 solid transparent{% endif %};
    {% if grid_border_m %}
      overflow: hidden;
    {% elsif block.settings.carousel_bleed %}
      overflow: visible;
    {% else %}
      overflow-x: clip;
      overflow-y: visible;
    {% endif %}
  }
  .big-inner--{{ block.id }} {
    --big-cols: {{ cols_m }};
    --big-border-width: {{ block.settings.border_width }}px;
    --big-slide-gap: var(--ds-item-gap-mobile);
    --big-radius: var(--ds-item-radius-mobile);
    --big-divider-opacity: {{ block.settings.divider_opacity }}%;
    --big-divider-length: {{ divider_length_m }};
    display: block;
    width: 100%;
    box-sizing: border-box;
    {% if block.settings.carousel_bleed == false %}
      overflow-x: clip;
      overflow-y: visible;
    {% endif %}

    position: relative;
  }

  /* --- Fade Shadow Overlays (Backdrop Shadows) --- */
  .big-inner--{{ block.id }} .fade-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    width: {{ block.settings.fade_width }}%;
    z-index: 2;
    pointer-events: none;
  }

  .big-inner--{{ block.id }} .fade-left {
    left: 0;
    background: linear-gradient(to right, var(--color-base), transparent);
  }

  .big-inner--{{ block.id }} .fade-right {
    right: 0;
    background: linear-gradient(to left, var(--color-base), transparent);
  }

  .big-inner--{{ block.id }} .swiper {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding-inline: {{ block.settings.swiper_padding }}rem;
  }

  .big-inner--{{ block.id }} .swiper-wrapper {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: flex-start;
    gap: 0;
    width: 100%;
    height: auto !important;
    box-sizing: border-box;
  }
  .big-inner--{{ block.id }} .swiper-wrapper > * {
    position: relative;
    min-width: 0;
    box-sizing: border-box;
    flex: 0 0 calc(100% / var(--big-cols));
    border-radius: var(--big-radius);
  }
  {%- comment -%} Before Swiper builds, slides take the width it will give them (gap included). {%- endcomment -%}
  {%- capture big_scope -%}.big-carousel--{{ block.id }}{%- endcapture -%}
  {% render 'carousel-preinit-width', scope: big_scope, spv_mobile: cols_m, spv_desktop: cols_d, gap: 'var(--big-slide-gap)' %}
  .big-wrapper--{{ block.id }} .swiper-wrapper > .swiper-slide {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-self: stretch;
    height: auto !important;
  }
  .big-wrapper--{{ block.id }} .swiper-wrapper > .swiper-slide > .block-item[data-height-mode="stretch"] {
    flex: 1 1 auto;
    height: 100%;
    align-self: stretch;
  }
  .big-wrapper--{{ block.id }} .swiper-wrapper > .swiper-slide.block-item[data-height-mode="stretch"] {
    height: auto !important;
    align-self: stretch;
  }

  {% if block.settings.show_dividers %}
    .big-inner--{{ block.id }} .swiper-wrapper > .swiper-slide:not(:first-of-type)::before {
      content: "";
      position: absolute;
      left: calc(var(--big-slide-gap) / -2);
      top: 50%;
      height: var(--big-divider-length);
      width: var(--big-border-width);
      background-color: var(--color-border);
      opacity: var(--big-divider-opacity);
      transform: translate(-50%, -50%);
    }
  {% endif %}

  @media (min-width: 768px) {
    .big-inner--{{ block.id }} {
      --big-cols: {{ cols_d }};
      --big-radius: var(--ds-item-radius-desktop);
      --big-slide-gap: var(--ds-item-gap-desktop);
      --big-divider-length: {{ divider_length_d }};
      {% if block.settings.carousel_bleed %}
        overflow: visible;
      {% endif %}
    }

    .big-wrapper--{{ block.id }} {
      border-radius: var(--ds-layout-radius-desktop);
      border: {% if grid_border_d %}{{ block.settings.border_width }}px solid var(--color-border){% else %}0 solid transparent{% endif %};
      {% if grid_border_d %}
        overflow: hidden;
      {% elsif block.settings.carousel_bleed %}
        overflow: visible;
      {% else %}
        overflow-x: clip;
        overflow-y: visible;
      {% endif %}
    }
  }

    /* Entrance timing for snippets/motion-reveal (items inherit it). */
    .big-carousel--{{ block.id }} {
      {% render 'motion-reveal', part: 'vars', from: anim %}
    }
{% endstyle %}

<container-carousel
  class="big-carousel--{{ block.id }}"
  data-carousel-bleed="{{ block.settings.carousel_bleed }}"
  data-layout-mobile="carousel"
  data-layout-desktop="carousel"
  data-spv-mobile="{{ block.settings.columns_mobile }}"
  data-spv-desktop="{{ block.settings.columns_desktop }}"
  data-gap="0"
  data-loop="false"
  data-arrows="false"
  data-dots="false"
  {{ block.shopify_attributes }}
>
  <div class="big-outer--{{ block.id }}">
    <div class="big-wrapper--{{ block.id }}">
      <stats-counter class="big-inner big-inner--{{ block.id }}" data-animate="true">
        {% if block.settings.enable_fades %}
          <div class="fade-overlay fade-right"></div>
          <div class="fade-overlay fade-left"></div>
        {% endif %}
        <div class="swiper">
          {%- comment -%}
            Only one content_for 'blocks' call is allowed per block file, so the
            element always renders and data-animate gates the count-up in JS.
          {%- endcomment -%}
          <div class="swiper-wrapper {% render 'motion-reveal', part: 'class', from: anim, group: true %}">
            {% content_for 'blocks' %}
          </div>
        </div>
      </stats-counter>
    </div>
  </div>
</container-carousel>

