{%- comment -%}
  Inline Image Text — Bold text (private). A run of words in the section's
  font and size at the chosen thickness. Renders an inline span followed by a
  space so the next block flows on like the next word.
{%- endcomment -%}

{% style %}
  .iit-text--{{ block.id }} {
    --iit-weight: {{ block.settings.font_weight | default: '700' }};
  }
{% endstyle %}

<span class="iit-text iit-text--bold iit-text--{{ block.id }}" {{ block.shopify_attributes }}>
  {{- block.settings.text | strip | escape -}}
</span>{{ ' ' }}

{% stylesheet %}
  .iit-text--bold {
    font-style: normal;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bold text",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Make you look"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Thickness",
      "info": "A font without this thickness uses its closest one.",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    }
  ],
  "presets": [
    {
      "name": "Bold text"
    }
  ]
}
{% endschema %}
