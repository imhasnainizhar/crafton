{%- comment -%}
  Verification Icon (private) — shield-checkmark glyph for
  blocks/_badge.liquid, defaulting to the built-in shield mark. Optionally
  overridden with an uploaded image or custom SVG code.
{%- endcomment -%}

<span class="badge-icon badge-icon--{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.icon_source == 'upload' and block.settings.icon_image != blank -%}
    {{ block.settings.icon_image | image_url: width: 64 | image_tag: alt: '', loading: 'lazy' }}
  {%- elsif block.settings.icon_source == 'svg' and block.settings.icon_svg != blank -%}
    {{ block.settings.icon_svg }}
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
    </svg>
  {%- endif -%}
</span>

{% style %}
  .badge-icon--{{ block.id }} {
    display: inline-flex;
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
    color: inherit;
  }

  .badge-icon--{{ block.id }} :is(svg, img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
{% endstyle %}

{% schema %}
{
  "name": "Verification Icon",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Verification Icon",
      "info": "Defaults to the built-in shield-checkmark glyph. Override it below if needed."
    },
    {
      "type": "select",
      "id": "icon_source",
      "label": "Icon Source",
      "options": [
        { "value": "upload", "label": "Upload" },
        { "value": "svg", "label": "Svg" }
      ],
      "default": "svg"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon image",
      "visible_if": "{{ block.settings.icon_source == 'upload' }}"
    },
    {
      "type": "html",
      "id": "icon_svg",
      "label": "SVG code",
      "info": "Leave blank to keep the default shield-checkmark.",
      "visible_if": "{{ block.settings.icon_source == 'svg' }}"
    }
  ],
  "presets": [
    {
      "name": "Verification Icon"
    }
  ]
}
{% endschema %}
