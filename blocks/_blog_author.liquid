{%- comment -%}
  Blog Author — who writes the closest blog (`closest.blog`). Shopify blogs
  have no author of their own, so this is the author of the blog's latest
  post, or a name the merchant types (an editorial team, a host). Text-role
  type through snippets/typography-resolver.liquid, colour through
  snippets/color-role-resolver.liquid.
{%- endcomment -%}

{% stylesheet %}
  .blg-author {
    margin: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .blg-author .blg-author__prefix { opacity: 0.72; }
{% endstylesheet %}

{%- liquid
  assign bl = closest.blog
  if block.settings.source == 'custom'
    assign author = block.settings.name
  else
    assign author = bl.articles.first.author
  endif
  if author == blank and bl == blank
    assign author = 'theme.components.blog_card.placeholder_author' | t
  endif
-%}

{%- if author != blank -%}
  {% style %}
    .blg-author--{{ block.id }} {
      {% render 'typography-resolver', role: 'text', source: block.settings %}
      {% render 'color-role-resolver', mode: 'color', role: 'text', source: block.settings %}
    }
  {% endstyle %}

  <p class="blg-author blg-author--{{ block.id }}" {{ block.shopify_attributes }}>
    {%- if block.settings.prefix != blank -%}
      <span class="blg-author__prefix">{{ block.settings.prefix | escape }} </span>
    {%- endif -%}
    {{- author | escape -}}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Blog Author",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Blog Author",
      "info": "Shopify blogs have no author of their own, so show who wrote the latest post or type a name."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Show",
      "options": [
        { "value": "latest", "label": "Author of the latest post" },
        { "value": "custom", "label": "A name I type" }
      ],
      "default": "latest"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Editorial team",
      "visible_if": "{{ block.settings.source == 'custom' }}"
    },
    {
      "type": "text",
      "id": "prefix",
      "label": "Text before the name",
      "default": "By"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Size",
      "options": [
        { "value": "xxs", "label": "Extra small" },
        { "value": "xs", "label": "Small" },
        { "value": "sm", "label": "Medium" },
        { "value": "md", "label": "Body" }
      ],
      "default": "xs"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "medium", "label": "Medium" },
        { "value": "semibold", "label": "Semi-bold" },
        { "value": "bold", "label": "Bold" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "override_line_height",
      "label": "Override Theme Line Height",
      "default": false
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2.4,
      "step": 0.1,
      "default": 1.4,
      "visible_if": "{{ block.settings.override_line_height }}"
    },
    {
      "type": "select",
      "id": "text_casing",
      "label": "Text Casing",
      "info": "On None, the text renders exactly as typed.",
      "options": [
        { "value": "theme", "label": "Theme" },
        { "value": "none", "label": "None" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Color",
      "info": "Automatic follows this block's own role, so a card set to Accent recolors it.",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "heading", "label": "Heading" },
        { "value": "text", "label": "Text" },
        { "value": "soft", "label": "Soft Text" },
        { "value": "accent", "label": "Accent" },
        { "value": "parent", "label": "Inherit From Parent" }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "Blog Author"
    }
  ]
}
{% endschema %}
