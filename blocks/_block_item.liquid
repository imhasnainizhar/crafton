            "font_size": "sm",
            "text_color": "soft"
          }
        }
      },
      "block_order": [
        "icon",
        "heading",
        "paragraph"
      ]
    },
    {
      "name": "Stat Item",
      "settings": {
        "height_mode": "stretch"
      },
      "blocks": {
        "number": {
          "type": "_number",
          "settings": {
            "number": "92%",
            "font_weight": "500",
            "number_size": "h4",
            "enable_count_up": true
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading_text": "Brighter-looking skin",
            "heading_tag": "h6"
          }
        },
        "paragraph": {
          "type": "text",
          "settings": {
            "paragraph_text": "<p>Reported after eight weeks of use.</p>"
          }
        }
      },
      "block_order": [
        "number",
        "heading",
        "paragraph"
      ]
    }
  ]
}
{% endschema %}
