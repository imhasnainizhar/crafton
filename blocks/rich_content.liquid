{%- comment -%}
  Rich Content

  - Public content-layout block: hosts heading, subtitle, text, button, icon,
    and divider blocks.
  - Owns alignment, content width, spacing, the optional panel surface
    (background and border), and entrance motion.
  - `scheme_source` (Section | Block) decides where colours come from: Section
    inherits the parent section's scheme, Block paints `color-<scheme>` on the
    panel. It is a select, not an inheritance checkbox.
  - The surface is a SEPARATE axis from the scheme source. Background, Solid /
    Glass style, every glass control and the border are available on both
    values — a block on the section's scheme can still be a glass panel, and a
    block on its own scheme can stay transparent.
  - Owns its horizontal text padding through the block's padding dropdown.
  - The panel's corner radius reads --ds-layout-radius-* and has no block-level
    override.
{%- endcomment -%}

{% stylesheet %}
  /* Panel: full width of the parent. Optional background and border use the
     active color-scheme tokens. Corner radius follows the Design System's
     Layout radius token. */
  .rich-content-panel {
    box-sizing: border-box;
    width: 100%;
    border-radius: var(--ds-layout-radius-mobile);
    display: flex;
    justify-content: var(--align-x-mobile, flex-start);
  }

  .rich-content-panel--hide-mobile { display: none; }

  .rich-content-panel--bg { background-color: var(--rc-bg); }

  .rich-content-panel--glass {
    background-color: var(--rc-glass-bg);
    -webkit-backdrop-filter: blur(var(--rc-glass-blur));
    backdrop-filter: blur(var(--rc-glass-blur));
    box-shadow: 0 8px 32px var(--rc-glass-shadow);
  }

  .rich-content-panel--border { border: 1px solid var(--rc-border); }

  /* Fill Parent Height: `align-self: stretch` fills a flex or grid parent and
     `min-height: 100%` fills a block parent with a real height; `height: 100%`
     would opt out of the parent's stretch. */
  .rich-content-panel--full {
    align-self: stretch;
    min-height: 100%;
  }

  /* Content rail: full width until the block's Content Width cap. In full
     height it becomes a column so the stack can flex into that height. */
  .rich-content-align {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--rc-max-width);
  }

  .rich-content-panel--full .rich-content-align {
    display: flex;
    flex-direction: column;
  }

  /* Content stack: owns child alignment, gap and text padding; its vertical
     margins provide the optional spacing behaviour. */
  .rich-content {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    gap: var(--rc-gap);
    width: 100%;
    padding-inline: var(--rc-pad-x);
    padding-block: var(--rc-pad-y);
    align-items: var(--align-x-mobile, flex-start);
    text-align: var(--rc-text-align-mobile);
    margin-block-start: var(--rc-margin);
    margin-block-end: var(--rc-margin);
  }

  .rich-content-panel--full .rich-content {
    flex: 1 1 auto;
    justify-content: var(--align-y-mobile, flex-start);
  }

  @media screen and (min-width: 768px) {
    .rich-content-panel {
      display: flex;
      justify-content: var(--align-x-desktop, flex-start);
      border-radius: var(--ds-layout-radius-desktop);
    }

    .rich-content--split-align {
      align-items: var(--align-x-desktop);
      text-align: var(--rc-text-align-desktop);
    }

    .rich-content-panel--full .rich-content {
      justify-content: var(--align-y-desktop, flex-start);
    }
  }
{% endstylesheet %}

{%- liquid
  # Inner text padding is separate from the parent wrapper's gutter and is
  # always owned by this block.
  capture rc_padding
    render 'space-token', key: block.settings.padding_horizontal
  endcapture
  assign rc_padding_mobile = rc_padding

  assign margin_scale_mode = block.settings.margin_scale_mode | default: 'auto'
  if margin_scale_mode == 'auto'
    assign margin_scale = 'auto'
  else
    assign margin_scale = block.settings.margin_scale_factor | default: 1
  endif

  assign max_width_css = block.settings.content_width | default: 768 | append: 'px'

  # The surface is independent of where the colour scheme comes from: a block
  # on the section's scheme can still paint a background, and a block on its own
  # scheme can stay transparent.
  assign background_active = block.settings.en_bg

  # Motion is independent of any animating parent: panel animates the stack and
  # lines its direct children (snippets/motion-reveal, CSS).
  assign rc_anim_on = block.settings.animation_enabled
  assign rc_scope = block.settings.animation_scope | default: 'panel'
  assign rc_lines = false
  if rc_scope == 'lines'
    assign rc_lines = true
  endif
  assign rc_reveal = false
  if rc_anim_on
    assign rc_reveal = true
  endif
  assign rc_order = block.settings.animation_play_mode
  case rc_order
    when 'row_by_row'
      assign rc_order = 'rows'
    when 'random'
      assign rc_order = 'scatter'
  endcase
-%}

{% style %}
  .rich-content-panel-{{ block.id }} {
    {% render 'alignments', source: block.settings %}
    --rc-max-width: {{ max_width_css }};
    --rc-gap: {% render 'space-token', key: block.settings.gap %};
    --rc-pad-x: {{ rc_padding_mobile }};
    --rc-pad-y: {% render 'space-token', key: block.settings.padding_vertical %};
    --rc-text-align-mobile: {{ block.settings.align_x_mobile }};
    --rc-text-align-desktop: {{ block.settings.align_x_desktop }};
    --rc-margin: {% if margin_scale == 'auto' %}auto{% else %}calc({{ margin_scale }} * 1rem){% endif %};
    {% if background_active %}
      --rc-bg: {% render 'background-role-token', key: block.settings.background_role %};
      {% if block.settings.background_style == 'glass' %}
        --rc-glass-bg: color-mix(in srgb, {% render 'background-role-token', key: block.settings.background_role %} {{ block.settings.glass_tint_opacity }}%, transparent);
        --rc-glass-blur: {{ block.settings.glass_blur }}px;
        --rc-glass-shadow: color-mix(in srgb, var(--color-shadow) {{ block.settings.glass_shadow_opacity }}%, transparent);
      {% endif %}
    {% endif %}
    {% if block.settings.en_br %}
      --rc-border: {% if background_active and block.settings.background_style == 'glass' %}color-mix(in srgb, var(--color-border) {{ block.settings.glass_border_opacity }}%, transparent){% else %}var(--color-border){% endif %};
    {% endif %}
  }

  {%- if rc_reveal -%}
    /* Entrance timing for snippets/motion-reveal. Text reveal wipes in from the
       edge the text is aligned to. */
    .rich-content-{{ block.id }} {
      {% render 'motion-reveal', part: 'vars', from: block.settings %}
      --motion-reveal-clip: {% if block.settings.align_x_mobile == 'right' %}inset(0 0 0 100%){% else %}inset(0 100% 0 0){% endif %};
    }

    @media (min-width: 768px) {
      .rich-content-{{ block.id }} { --motion-reveal-clip: {% if block.settings.align_x_desktop == 'right' %}inset(0 0 0 100%){% else %}inset(0 100% 0 0){% endif %}; }
    }
  {%- endif -%}
{% endstyle %}

<div
  class="rich-content-panel-{{ block.id }} rich-content-panel{% if block.settings.hide_on_mobile %} rich-content-panel--hide-mobile{% endif %}{% if background_active %}{% if block.settings.background_style == 'glass' %} rich-content-panel--glass{% else %} rich-content-panel--bg{% endif %}{% endif %}{% if block.settings.en_br %} rich-content-panel--border{% endif %}{% if block.settings.full_height %} rich-content-panel--full{% endif %}{% if block.settings.scheme_source == 'block' %} color-{{ block.settings.color_scheme }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="rich-content-align-{{ block.id }} rich-content-align">
    <div
      class="rich-content-{{ block.id }} rich-content{% if block.settings.align_x_desktop != block.settings.align_x_mobile %} rich-content--split-align{% endif %} {% render 'motion-reveal', part: 'class', from: block.settings, enabled: rc_reveal, group: rc_lines %}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

