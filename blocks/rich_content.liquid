      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 12,
      "visible_if": "{{ block.settings.background_style == 'glass' and block.settings.en_bg }}"
    },
    {
      "type": "checkbox",
      "id": "en_br",
      "label": "Enable border",
      "info": "Apply the color scheme's border color",
      "default": false
    },
    {
      "type": "range",
      "id": "glass_border_opacity",
      "label": "Glass border strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 15,
      "visible_if": "{{ block.settings.background_style == 'glass' and block.settings.en_bg and block.settings.en_br }}"
    },
    {
      "type": "header",
      "content": "Animation",
      "info": "This block's own entrance, independent of any animating parent. Leave off if a parent Container/Carousel already animates this block in."
    },
    {
      "type": "checkbox",
      "id": "animation_enabled",
      "label": "Enable animation",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_scope",
      "label": "What animates",
      "options": [
        {
          "value": "panel",
          "label": "Whole panel"
        },
        {
          "value": "lines",
          "label": "Stagger lines"
        }
