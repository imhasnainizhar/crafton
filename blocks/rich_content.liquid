      "id": "align_y_mobile",
      "label": "Vertical Alignment (Mobile)",
      "options": [
        {
          "value": "none",
          "label": "Default (in flow)"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.full_height }}"
    },
    {
      "type": "select",
      "id": "align_y_desktop",
      "label": "Vertical Alignment (Desktop)",
      "options": [
        {
          "value": "none",
          "label": "Default (in flow)"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.full_height }}"
    },
    {
