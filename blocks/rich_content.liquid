      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "options": [
        {
          "value": "480",
          "label": "Narrow (480px)"
        },
        {
          "value": "640",
          "label": "Medium (640px)"
        },
        {
          "value": "760",
          "label": "Default (760px)"
        },
        {
          "value": "960",
          "label": "Wide (960px)"
        },
        {
          "value": "1200",
          "label": "Extra Wide (1200px)"
        },
        {
          "value": "1600",
          "label": "Max (1600px)"
        }
      ],
      "default": "760"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Gap Between Items",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "SM"
        },
        {
          "value": "md",
          "label": "MD"
        },
        {
          "value": "lg",
          "label": "LG"
        },
        {
          "value": "xl",
          "label": "XL"
        }
      ],
      "default": "sm"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Fill Parent Height",
      "info": "Stretches the block to fill all available height instead of sizing to content. Enable when this block sits inside a container with a defined height.",
      "default": false
    },
    {
      "type": "header",
      "content": "Color Scheme",
      "info": "Where this block and its nested content take their colours from. The surface controls below apply either way."
    },
    {
      "type": "select",
      "id": "scheme_source",
      "label": "Color Scheme Source",
      "options": [
        {
          "value": "section",
          "label": "Section"
        },
        {
          "value": "block",
          "label": "Block"
        }
      ],
      "default": "section"
