      "default": "lines",
      "info": "Whole panel fades/reveals the content stack as one. Stagger lines reveals heading, text and button one by one.",
      "visible_if": "{{ block.settings.animation_enabled }}"
    },
    {
      "type": "select",
      "id": "animation_effect",
      "label": "Effect",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade-up",
          "label": "Fade Up"
        },
        {
          "value": "fade-down",
          "label": "Fade Down"
        },
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "scale",
          "label": "Scale"
        },
        {
          "value": "text-reveal",
          "label": "Text Reveal (Mask)"
        }
      ],
      "default": "fade-up",
      "info": "Text Reveal wipes the content in via a clip mask — left-to-right for left-aligned text, right-to-left for right-aligned.",
      "visible_if": "{{ block.settings.animation_enabled }}"
    },
    {
      "type": "select",
      "id": "animation_play_mode",
      "label": "Playback",
      "options": [
        {
          "value": "stagger",
          "label": "One by one"
        },
        {
          "value": "together",
          "label": "Together"
        },
        {
          "value": "row_by_row",
          "label": "Row by row"
        },
        {
          "value": "random",
          "label": "Random"
        }
      ],
      "default": "stagger",
      "visible_if": "{{ block.settings.animation_enabled and block.settings.animation_scope == 'lines' }}"
    },
    {
