{%- comment -%}
  Heading

  - Heading block; a thin wrapper over snippets/heading.liquid so every heading
    in the theme renders identical typography.
  - The heading tag is semantics/SEO only; size comes from the Size setting,
    resolved with every other typographic property by
    snippets/typography-resolver.liquid.
  - Supports the theme's animated accent treatment on bold and italic runs.
  - Accent settings are not resolved here: this block hands its settings object
    to snippets/accent-typography.liquid, which inherits the global Typography
    settings unless "Use Custom Accent Typography" is checked. The schema
    fragment for those settings is copy-pasted from that snippet's contract.
{%- endcomment -%}

{%- liquid
  # Lets a host section (e.g. Dynamic Hero on the collection template) drive
  # this heading from the resolved collection's title instead of static text,
  # via its own "Show collection title" checkbox. Both settings are section-
  # scoped, so this is a no-op wherever a section doesn't define them.
  assign effective_heading_text = block.settings.heading_text
  if section.settings.use_collection_data and section.settings.show_collection_title
    assign title_collection = blank
    if section.settings.use_picked_collection and section.settings.selected_collection != blank
      assign title_collection = section.settings.selected_collection
    elsif collection != blank
      assign title_collection = collection
    endif
    if title_collection != blank
      assign effective_heading_text = title_collection.title
    endif
  endif

  assign heading_has_count_up = false
  if effective_heading_text contains '[_'
    assign heading_has_count_up = true
    assign effective_heading_text = effective_heading_text | replace: '[_', '<span data-stat-value>' | replace: '_]', '</span>'
  endif
-%}

{% if heading_has_count_up %}
  <script src="{{ 'stats-counter.js' | asset_url }}" type="module"></script>
{% endif %}

<div style="{% render 'accent-resolver', source: block.settings %}" {{ block.shopify_attributes }}>
  {% if heading_has_count_up %}<stats-counter data-animate="true" style="display: block;">{% endif %}
  {% render 'heading',
    id: block.id,
    heading_text: effective_heading_text,
    heading_tag: block.settings.heading_tag,
    orientation: block.settings.heading_orientation,
    vertical_direction: block.settings.vertical_direction,
    source: block.settings
  %}
  {% if heading_has_count_up %}</stats-counter>{% endif %}
</div>

