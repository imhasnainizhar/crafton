{%- comment -%}
  Row Media Item (private) — a full-bleed image or Shopify-hosted video for
  the Row Media composition. Videos autoplay muted, loop, and never expose
  controls. This item intentionally has no border-radius setting or styling.
  Dependency: media-block.js / <media-autoplay>.
{%- endcomment -%}

{%- liquid
  assign media_type = block.settings.media_type | default: 'image'
  assign resolved_media_type = 'placeholder'
  if media_type == 'video' and block.settings.video != blank
    assign resolved_media_type = 'video'
  elsif media_type == 'image' and block.settings.image != blank
    assign resolved_media_type = 'image'
  elsif block.settings.video != blank
    assign resolved_media_type = 'video'
  elsif block.settings.image != blank
    assign resolved_media_type = 'image'
  endif
-%}

<script src="{{ 'media-block.js' | asset_url }}" defer="defer"></script>

{% style %}
  .row-media-item--{{ block.id }} {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .row-media-item--{{ block.id }} .row-media-item__background,
  .row-media-item--{{ block.id }} .row-media-item__media,
  .row-media-item--{{ block.id }} .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .row-media-item--{{ block.id }} .row-media-item__media,
  .row-media-item--{{ block.id }} .placeholder-svg {
    display: block;
    border: 0;
    object-fit: {{ block.settings.object_fit | default: 'cover' }};
  }

  .row-media-item--{{ block.id }} .placeholder-svg {
    background-color: var(--color-surface);
    color: var(--color-text);
    fill: var(--color-text);
  }
{% endstyle %}

<media-autoplay class="row-media-item--{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="row-media-item__background">
    {%- case resolved_media_type -%}
      {%- when 'video' -%}
        {{
          block.settings.video
          | video_tag:
            image_size: '2000x',
            autoplay: true,
            muted: true,
            playsinline: true,
            controls: false,
            loop: true,
            class: 'row-media-item__media'
        }}
      {%- when 'image' -%}
        {{
          block.settings.image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            sizes: '50vw',
            widths: '550, 750, 1100, 1500, 2000, 2400',
            class: 'row-media-item__media',
            alt: block.settings.image.alt
        }}
      {%- when 'placeholder' -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endcase -%}
  </div>
</media-autoplay>

{% schema %}
{
  "name": "Row Media Item",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Media",
      "info": "Choose an image or video. Videos autoplay muted, loop, and never show controls."
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Media Fit",
      "options": [
        { "value": "cover", "label": "Cover (Crop to fill)" },
        { "value": "contain", "label": "Contain (Show full media)" },
        { "value": "fill", "label": "Fill (Stretch to fit)" }
      ],
      "default": "cover"
    }
  ],
  "presets": [
    {
      "name": "Row Media Item"
    }
  ]
}
{% endschema %}
