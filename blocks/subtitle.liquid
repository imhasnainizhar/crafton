        {
          "value": "yoyo",
          "label": "Yoyo (draw & undraw)"
        },
        {
          "value": "restart",
          "label": "Restart"
        }
      ],
      "visible_if": "{{ block.settings.use_custom_accent_typography and block.settings.accent_loop and block.settings.accent_trigger == 'in_view' }}"
    }
  ],
  "presets": [
    {
      "name": "Subtitle"
    }
  ]
}
{% endschema %}
