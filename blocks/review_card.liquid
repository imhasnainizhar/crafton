  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media",
      "info": "None makes this a text-only card. Image shows a still. Video adds a play control.",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "thumbnail",
      "label": "Image",
      "info": "Used as the poster frame for a video. Falls back to the video's own preview image.",
      "visible_if": "{{ block.settings.media_type != 'none' }}"
    },
    {
      "type": "select",
      "id": "video_source",
      "label": "Video source",
      "options": [
        {
          "value": "upload",
          "label": "Upload"
        },
        {
          "value": "link",
          "label": "Link"
        }
      ],
      "visible_if": "{{ block.settings.media_type == 'video' }}",
      "default": "upload"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Upload Video",
      "visible_if": "{{ block.settings.media_type == 'video' and block.settings.video_source == 'upload' }}"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video link",
      "info": "A direct file URL (.mp4, .webm, .ogv). Not a YouTube or Vimeo page link.",
      "visible_if": "{{ block.settings.media_type == 'video' and block.settings.video_source == 'link' }}"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media aspect ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16 / 9",
          "label": "Landscape (16:9)"
        }
      ],
      "visible_if": "{{ block.settings.media_type != 'none' }}",
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Layout & Alignment"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Content mode",
      "info": "Flow places content below the media. Overlay places it on top of the media.",
      "options": [
        {
          "value": "flow",
          "label": "Flow"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        }
      ],
      "visible_if": "{{ block.settings.media_type != 'none' }}",
      "default": "flow"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Card Height",
      "info": "Auto follows the card content size. Stretch matches the height of the biggest sibling card.",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "stretch",
          "label": "Stretch"
