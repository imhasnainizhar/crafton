{%- comment -%}
  Image — a full-bleed image stage, height driven by aspect ratio per
  breakpoint (or the viewport in Full Height Mode), with an optional Heading
  block floating on top. No other text blocks are allowed. Overlay treatment
  (tint / shadow) comes from snippets/media-overlay-tint.liquid, shared with
  the Video section.
{%- endcomment -%}

{%- liquid
  assign ar_mobile = section.settings.aspect_mobile | default: '4 / 5'
  assign ar_desktop = section.settings.aspect_desktop | default: '16 / 9'

  assign has_mobile_image = false
  if section.settings.mobile_image != blank
    assign has_mobile_image = true
  endif

  assign desktop_classes = 'media-element'
  if has_mobile_image
    assign desktop_classes = 'media-element hide-mobile'
  endif

  assign media_zoom_on = false
  if section.settings.media_zoom_enabled and settings.disable_all_animations == false
    assign media_zoom_on = true
  endif

  assign full_height_mode = section.settings.full_height_mode
  assign design_mode_mobile = section.settings.design_mode_mobile
  assign design_mode_desktop = section.settings.design_mode_desktop
-%}

{% style %}
  /* Mobile-first base + single 768px desktop override. */
  .image-section--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    --image-media-radius: var(--ds-layout-radius-mobile);
    background-color: var(--color-base);
    color: var(--color-text);
    overflow-x: clip;
    overflow-y: visible;
  }

  .image-section--{{ section.id }} .image-section__rail {
    padding-inline: var(--ds-layout-gutter-mobile);
    padding-block: var(--ds-section-padding-mobile);

    {% if section.settings.design_mode_mobile == 'modern' %}
      box-sizing: border-box;
    {% else %}
      {% if section.settings.full_height_mode %}
        box-sizing: content-box;
      {% endif %}
    {% endif %}

    {% if full_height_mode %}
      height: var(--viewport-height, 100vh);
    {% endif %}
  }

  .image-section--{{ section.id }} .image-section__stage {
    position: relative;
    width: 100%;
    border-radius: var(--image-media-radius);
    overflow: hidden;

    {% if full_height_mode %}
      height: 100%;
    {% elsif ar_mobile != 'auto' %}
      aspect-ratio: {{ ar_mobile }};
    {% endif %}
  }

  .image-section--{{ section.id }} .image-section__media {
    z-index: 1;
    {% if full_height_mode %}
      position: absolute;
      inset: 0;
      overflow: hidden;
    {% elsif ar_mobile == 'auto' %}
      position: relative;
    {% else %}
      position: absolute;
      inset: 0;
      overflow: hidden;
    {% endif %}
  }

  .image-section--{{ section.id }} .media-element {
    object-fit: {{ section.settings.object_fit }};
    {% if full_height_mode %}
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    {% elsif ar_mobile == 'auto' %}
      position: static;
      display: block;
      width: 100%;
      height: auto;
    {% else %}
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    {% endif %}
  }

  .image-section--{{ section.id }} .image-section__motion {
    position: relative;
    width: 100%;
    height: 100%;
    {%- if media_zoom_on %}
      {% render 'motion-reveal', part: 'vars', from: section.settings, prefix: 'media_zoom', enabled: media_zoom_on %}
    {%- endif %}
  }

  {% if ar_mobile == 'auto' and full_height_mode == false %}
    .image-section--{{ section.id }} .image-section__motion {
      height: auto;
    }
  {% endif %}

  .image-section--{{ section.id }} .placeholder-svg {
    background-color: var(--color-surface);
    fill: var(--color-text);
  }

  .image-section--{{ section.id }} .hide-mobile {
    display: none;
  }

  @media screen and (min-width: 768px) {
    .image-section--{{ section.id }} {
      --image-media-radius: var(--ds-layout-radius-desktop);
    }

    .image-section--{{ section.id }} .image-section__rail {
      padding-inline: var(--ds-layout-gutter-desktop);
      padding-block: var(--ds-section-padding-desktop);

      {% if section.settings.design_mode_desktop == 'modern' %}
        box-sizing: border-box;
      {% else %}
        {% if section.settings.full_height_mode %}
          box-sizing: content-box;
        {% endif %}
      {% endif %}

      {% if full_height_mode %}
        height: var(--viewport-height, 100vh);
      {% endif %}
    }
    .image-section--{{ section.id }} .hide-mobile {
      display: block;
    }

    .image-section--{{ section.id }} .hide-desktop {
      display: none;
    }

    .image-section--{{ section.id }} .image-section__stage {
      border-radius: var(--image-media-radius);

      {% if full_height_mode %}
        height: 100%;
      {% else %}
        aspect-ratio: {{ ar_desktop }};
      {% endif %}
    }

    {% unless full_height_mode %}
      {% if ar_desktop == 'auto' and ar_mobile != 'auto' %}
        .image-section--{{ section.id }} .image-section__media {
          position: relative;
          inset: auto;
        }
        .image-section--{{ section.id }} .media-element {
          position: static;
          inset: auto;
          width: 100%;
          height: auto;
          display: block;
        }
      {% elsif ar_desktop != 'auto' and ar_mobile == 'auto' %}
        .image-section--{{ section.id }} .image-section__media {
          position: absolute;
          inset: 0;
          overflow: hidden;
        }
        .image-section--{{ section.id }} .media-element {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
        }
      {% endif %}
    {% endunless %}
  }
{% endstyle %}

<div class="image-section--{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="image-section__rail">
    <div class="image-section__stage">
    <div
      class="image-section__media"
    >
      <div
        class="image-section__motion {% render 'motion-reveal', part: 'class', from: section.settings, prefix: 'media_zoom', enabled: media_zoom_on, effect: 'media-zoom-out' %}"
      >
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              sizes: '100vw',
              widths: '550, 750, 1100, 1500, 1780, 2000',
              class: desktop_classes,
              alt: section.settings.image.alt
          }}
        {%- else -%}
          {%- assign placeholder_class = desktop_classes | append: ' placeholder-svg' -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: placeholder_class }}
        {%- endif -%}

        {%- if has_mobile_image -%}
          {{
            section.settings.mobile_image
            | image_url: width: 1100
            | image_tag:
              loading: 'lazy',
              sizes: '100vw',
              widths: '375, 550, 750, 1100',
              class: 'media-element hide-desktop',
              alt: section.settings.mobile_image.alt
          }}
        {%- endif -%}
      </div>
    </div>

    {% render 'media-overlay-tint', id: section.id, s: section.settings %}

    <div class="mc-content mc-content--{{ section.id }}">
      {% content_for 'blocks' %}
    </div>
    </div>
  </div>
</div>

