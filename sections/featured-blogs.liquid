{%- comment -%}
  FEATURED BLOGS (`bfx-`) — shell only.
  Blog Cards (whole Shopify blogs) beside a hero. Cloned from Featured Collections
  (`ffx-`) and kept file-independent from it: grid or carousel per breakpoint,
  Classic / Flyover / Tunnel carousels, the hero and "Content over hero", with
  hand-picked blog cards in the track. The shell owns the colour scheme, the
  vertical rhythm, the Design System panel, the one horizontal rail and the
  View all link copy; the Featured Blogs block inside owns the hero and the
  layout, and every card owns its own look.
  Depends on: blocks/_bfx_feature.liquid, blocks/blog_cover_card.liquid,
  blocks/rich_content.liquid, snippets/section-design-mode.liquid,
  assets/blogs-featured.js (<blogs-featured>), swiper-bundle.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}


{%- comment -%}
  `defer` preserves order, so Swiper exists before the controller that uses
  it. Swiper is loaded unconditionally: layout is a
  block setting now, and a shell never reads its blocks' settings.
{%- endcomment -%}
<script src="{{ 'blogs-featured.js' | asset_url }}" defer></script>

{% style %}
  /* One accent per section: resolved here, on the root, so open tabs, accent
     card plates and every other Accent consumer inside follow it. Doubled
     class so it outranks the colour-scheme class on the same element. */
  .bfx.bfx--{{ section.id }} {
    {% render 'accent-resolver', source: section.settings %}
  }

  .bfx--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    display: block;
    position: relative;
    background-color: var(--color-base);
    color: var(--color-text);
    padding-block: var(--ds-section-padding-mobile);
    /* The shell clips sideways so a bleeding carousel disappears at the screen
       edge, while hover lift and shadows still escape vertically. */
    overflow-x: clip;
    overflow-y: visible;
  }

  .bfx--{{ section.id }} .bfx__inner {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--ds-section-width-mobile);
    margin-inline: auto;
    /* The one rail: every block inside adds no horizontal inset of its own. */
    padding-inline: var(--ds-layout-gutter-mobile);
    display: flex;
    flex-direction: column;
    gap: var(--ds-layout-gap-mobile);
  }

  .bfx--{{ section.id }} .bfx__inner > * {
    width: 100%;
  }

  /* Rich Content bound for a hero ("Content over hero") is not painted above
     its Featured Blogs block first, in the moment before the controller runs. */
  .bfx--{{ section.id }}:not(.is-ready) .bfx__inner > :not([data-bfx-stage]):has(~ [data-bfx-hero-content]) {
    display: none;
  }

  @media (min-width: 768px) {
    .bfx--{{ section.id }} {
      padding-block: var(--ds-section-padding-desktop);
    }

    .bfx--{{ section.id }} .bfx__inner {
      max-width: var(--ds-section-width-desktop);
      padding-inline: var(--ds-layout-gutter-desktop);
      gap: var(--ds-layout-gap-desktop);
    }
  }
{% endstyle %}

<blogs-featured
  class="bfx bfx--{{ section.id }} color-{{ s.color_scheme }}"
>
  <div class="bfx__inner">
    {% content_for 'blocks' %}
  </div>
</blogs-featured>

