{%- comment -%}
  FAQ — section shell for a question-and-answer block: Rich Content for the
  intro and an FAQ List for the questions themselves. Elewind's FAQ without
  background media: the color scheme paints the background. Spacing, gutter,
  radius and shadow read the Design System tokens the section emits.
{%- endcomment -%}

{% style %}
  .faq-section--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    --faq-min-height: {{ section.settings.min_height | default: 560 }}px;
  }
{% endstyle %}

<section
  class="faq-section faq-section--{{ section.id }} color-{{ section.settings.color_scheme | default: 'scheme_1' }}"
  data-full-height="{{ section.settings.full_height }}"
>
  {%- if section.settings.full_height -%}
    <script>document.currentScript.parentElement.classList.add('is-parsing');</script>
  {%- endif -%}
  <div class="faq-section__inner">
    {% content_for 'blocks' %}
  </div>
  {%- if section.settings.full_height -%}
    <script>document.currentScript.parentElement.classList.remove('is-parsing');</script>
  {%- endif -%}
</section>

{% stylesheet %}
  .faq-section {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-block: var(--ds-section-padding-mobile);
    padding-inline: 0;
    background: var(--color-base);
    color: var(--color-text);

    --faq-layout-gap: var(--ds-layout-gap-mobile);
    --faq-gutter: var(--ds-layout-gutter-mobile);
    --faq-item-gap: var(--ds-item-gap-mobile);
    --faq-item-border-width: var(--ds-item-border-width-mobile);
    --faq-item-radius: var(--ds-item-radius-mobile);
    --faq-item-shadow: var(--ds-item-shadow-mobile);
  }

  .faq-section[data-full-height='true'] {
    min-height: max(var(--faq-min-height), 100vh);
    display: flex;
    align-items: center;
  }

  /* Centred content re-centres as the page streams in (heading first, items
     later), which the browser reports as a layout shift. Hold painting until
     the section's closing script has run; layout still happens, so nothing
     moves on screen. Without JS the class is never added. */
  .faq-section.is-parsing .faq-section__inner {
    visibility: hidden;
  }

  .faq-section__inner {
    position: relative;
    width: 100%;
    max-width: var(--ds-section-width-mobile);
    min-width: 0;
    margin-inline: auto;
    padding-inline: var(--faq-gutter);
    display: flex;
    flex-direction: column;
    gap: var(--faq-layout-gap);
    --align-x: flex-start;
    --text-align: left;
  }

  .faq-section__inner > * {
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .faq-section {
      padding-block: var(--ds-section-padding-desktop);
      --faq-layout-gap: var(--ds-layout-gap-desktop);
      --faq-gutter: var(--ds-layout-gutter-desktop);
      --faq-item-gap: var(--ds-item-gap-desktop);
      --faq-item-border-width: var(--ds-item-border-width-desktop);
      --faq-item-radius: var(--ds-item-radius-desktop);
      --faq-item-shadow: var(--ds-item-shadow-desktop);
    }

    .faq-section__inner {
      max-width: var(--ds-section-width-desktop);
    }
  }
{% endstylesheet %}

