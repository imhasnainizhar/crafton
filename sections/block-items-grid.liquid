{%- comment -%}
  Block Items Grid

  - Dedicated shell that hosts exactly one Block Items Grid block.
  - Owns the color scheme and the outer vertical padding, nothing else.
  - Section padding reads the resolved Design System token, so the global
    default and a per-section override share one code path.
{%- endcomment -%}

{% style %}
  .block-items-grid-section--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    width: 100%;
    padding-block: var(--ds-section-padding-mobile);
    padding-inline: var(--ds-layout-gutter-mobile);
    background-color: var(--color-base);
    overflow-x: clip;
    overflow-y: visible;
  }

  /* Desktop section padding comes from the resolved Design System token, so a
     section override (Use own Design Mode) and the global default share one path. */
  @media (min-width: 768px) {
    .block-items-grid-section--{{ section.id }} {
      padding-block: var(--ds-section-padding-desktop);
      padding-inline: var(--ds-layout-gutter-desktop);
    }
  }
{% endstyle %}

<div class="block-items-grid-section--{{ section.id }} color-{{ section.settings.color_scheme }}">
  {% content_for 'blocks' %}
</div>

