{%- comment -%}
  404 page — the not-found message and a link back to the catalog, inside the
  shared page shell (assets/base.css, .page-shell).
{%- endcomment -%}
<div class="page-shell page-shell--narrow color-{{ section.settings.color_scheme }}">
  <div class="page-shell__inner">
    <h1 class="page-shell__title">{{ '404.title' | t }}</h1>
    <p>{{ '404.not_found' | t }}</p>
    <p>
      <a class="page-shell__link" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "shopify-section--main",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
