{%- comment -%}
  Newsletter — a full-width section that owns the color scheme, vertical
  spacing, and centers its content column. Any theme block can be nested
  inside (heading, email signup, icon, …). The wrapper always spans the
  section; individual blocks control their own readable width and alignment.
{%- endcomment -%}

{% style %}
  .newsletter--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    display: block;
    width: 100%;
    padding-block: var(--ds-section-padding-mobile);
    background-color: var(--color-base);
    color: var(--color-text);
  }

  .newsletter--{{ section.id }} .newsletter__inner {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--ds-layout-gap-mobile);
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--ds-layout-gutter-mobile);
    /* Content is always centered — no merchant alignment option. */
    --align-x: center;
    --text-align: center;
  }

  @media screen and (min-width: 768px) {
    .newsletter--{{ section.id }} {
      padding-block: var(--ds-section-padding-desktop);
    }

    .newsletter--{{ section.id }} .newsletter__inner {
      gap: var(--ds-layout-gap-desktop);
      padding-inline: var(--ds-layout-gutter-desktop);
    }
  }
{% endstyle %}

<section class="newsletter--{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="newsletter__inner">
    {% content_for 'blocks' %}
  </div>
</section>

