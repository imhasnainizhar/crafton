{%- comment -%}
  Password page — the store's password message and the storefront password
  form, centered inside the shared page shell (assets/base.css, .page-shell).
{%- endcomment -%}
<div class="page-shell page-shell--narrow page-shell--center color-{{ section.settings.color_scheme }}">
  <div class="page-shell__inner">
    <h1 class="page-shell__title">{{ 'password.title' | t }}</h1>

    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'page-shell__form' -%}
      {%- if form.errors -%}
        {{ form.errors | default_errors }}
      {%- endif -%}
      <label for="password-input">{{ 'password.password' | t }}</label>
      <input type="password" name="password" id="password-input" autocomplete="current-password" required>
      <button type="submit" class="page-shell__button">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "shopify-section--main",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
