{%- comment -%}
  Media Row — a fixed-height stage filled by a statically rendered Row Media
  block (Row Media Items split by optional Vertical Dividers). Media only: no
  text blocks, so merchants just fill in each block's own settings.

  Owns the colour scheme, the stage dimensions, and the vertical spacing. The
  internal rail carries the layout gutter (screen-edge inset); the stage
  carries the layout cap and radius — same split as sections/image.liquid.
{%- endcomment -%}

{% style %}
  /* Mobile-first base + single 768px desktop override. */
  .row-media--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    display: block;
    width: 100%;
    background-color: var(--color-base);
    padding-block: var(--ds-section-padding-mobile);
    overflow-x: clip;
    overflow-y: visible;
  }

  .row-media--{{ section.id }} .row-media__rail {
    padding-inline: var(--ds-layout-gutter-mobile);
  }

  .row-media--{{ section.id }} .row-media__stage {
    position: relative;
    display: flex;
    width: 100%;
    max-width: var(--ds-section-width-mobile);
    margin-inline: auto;
    min-height: {{ section.settings.min_height }}px;
    height: {{ section.settings.height_mobile }}vh;
    border-radius: var(--ds-layout-radius-mobile);
    overflow: hidden;
  }

  @media screen and (min-width: 768px) {
    .row-media--{{ section.id }} {
      padding-block: var(--ds-section-padding-desktop);
    }

    .row-media--{{ section.id }} .row-media__rail {
      padding-inline: var(--ds-layout-gutter-desktop);
    }

    .row-media--{{ section.id }} .row-media__stage {
      max-width: var(--ds-section-width-desktop);
      height: {{ section.settings.height_desktop }}vh;
      border-radius: var(--ds-layout-radius-desktop);
    }
  }
{% endstyle %}

<div class="row-media--{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="row-media__rail">
    <div class="row-media__stage">
      {% content_for 'block', type: '_row_media', id: 'media' %}
    </div>
  </div>
</div>

