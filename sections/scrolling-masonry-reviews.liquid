{%- comment -%}
  Scrolling Masonry Reviews (`smr-`) â€” composition shell: color scheme,
  background, vertical padding and Design Mode, around Rich Content and a
  Scrolling Masonry block (blocks/_smr_masonry.liquid) that holds the Review
  Cards and does the scrolling, masonry layout and edge fade.
  The section owns the single gutter rail; its blocks add no inset.
{%- endcomment -%}

{% style %}
  .smr-section--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    background-color: {% render 'background-role-token', key: section.settings.background_role %};
  }
{% endstyle %}

{%- assign active_color_scheme = section.settings.color_scheme | default: 'scheme_1' -%}

<div class="smr-section smr-section--{{ section.id }} color-{{ active_color_scheme }}">
  <div class="smr-section__blocks">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .smr-section {
    padding-block: var(--ds-section-padding-mobile);
    padding-inline: 0;
    overflow-x: clip;
  }

  .smr-section__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--ds-layout-gap-mobile);
    padding-inline: var(--ds-layout-gutter-mobile);
  }

  .smr-section__blocks > * {
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .smr-section {
      padding-block: var(--ds-section-padding-desktop);
    }

    .smr-section__blocks {
      gap: var(--ds-layout-gap-desktop);
      padding-inline: var(--ds-layout-gutter-desktop);
    }
  }
{% endstylesheet %}

