{%- comment -%}
  FEATURED COLLECTION (`cfx-`) — shell only.
  One collection featured at a time. The shell owns the colour scheme, the
  vertical rhythm, the Design System panel and the one horizontal rail; the
  Collection block inside owns the hero, the layout and the products, because
  the block that composes a collection is the block that dictates its stage.
  Composition is pure theme-block order: Rich Content above a Collection block
  renders above it, dragged below it renders below — unless that Collection
  block has "Content over hero" on, in which case the controller moves the Rich
  Content placed right before it into its hero.
  Depends on: blocks/_cfx_collection.liquid, blocks/rich_content.liquid,
  snippets/section-design-mode.liquid, assets/collection-featured.js
  (<collection-featured>), swiper-bundle, loader-fetch.js + loader-state.js.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}


{%- comment -%}
  `defer` preserves order, so Swiper and the shared loader exist before the
  controller that uses them. Swiper is loaded unconditionally: layout is a
  block setting now, and a shell never reads its blocks' settings.
{%- endcomment -%}
<script src="{{ 'loader-fetch.js' | asset_url }}" defer></script>
<script src="{{ 'loader-state.js' | asset_url }}" defer></script>
<script src="{{ 'collection-featured.js' | asset_url }}" defer></script>

{% style %}
  /* One accent per section: resolved here, on the root, so open tabs, accent
     card plates and every other Accent consumer inside follow it. Doubled
     class so it outranks the colour-scheme class on the same element. */
  .cfx.cfx--{{ section.id }} {
    {% render 'accent-resolver', source: section.settings %}
  }

  .cfx--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    display: block;
    position: relative;
    background-color: var(--color-base);
    color: var(--color-text);
    padding-block: var(--ds-section-padding-mobile);
    /* The shell clips sideways so a bleeding carousel disappears at the screen
       edge, while hover lift and shadows still escape vertically. */
    overflow-x: clip;
    overflow-y: visible;
  }

  .cfx--{{ section.id }} .cfx__inner {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--ds-section-width-mobile);
    margin-inline: auto;
    /* The one rail: every block inside adds no horizontal inset of its own. */
    padding-inline: var(--ds-layout-gutter-mobile);
    display: flex;
    flex-direction: column;
    gap: var(--ds-layout-gap-mobile);
  }

  .cfx--{{ section.id }} .cfx__inner > * {
    width: 100%;
  }

  /* Rich Content bound for a hero ("Content over hero") is not painted above
     its Collection block first, in the moment before the controller runs. */
  .cfx--{{ section.id }}:not(.is-ready) .cfx__inner > :not([data-cfx-stage]):has(~ [data-cfx-hero-content]) {
    display: none;
  }

  @media (min-width: 768px) {
    .cfx--{{ section.id }} {
      padding-block: var(--ds-section-padding-desktop);
    }

    .cfx--{{ section.id }} .cfx__inner {
      max-width: var(--ds-section-width-desktop);
      padding-inline: var(--ds-layout-gutter-desktop);
      gap: var(--ds-layout-gap-desktop);
    }
  }
{% endstyle %}

<collection-featured
  class="cfx cfx--{{ section.id }} color-{{ s.color_scheme }}"
  data-cfx-section-id="{{ section.id }}"
  data-cfx-base-path="{{ request.path }}"
  data-cfx-carousel-load="{{ s.carousel_load }}"
  data-cfx-preload-threshold="{{ s.preload_threshold }}"
>
  <div class="cfx__inner">
    {% content_for 'blocks' %}
  </div>
</collection-featured>

