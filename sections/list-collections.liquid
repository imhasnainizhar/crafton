{%- comment -%}
  Collection List — shell section. Owns colour scheme, background, vertical
  padding, the gutter rail and the section's ONE accent (resolved on the root,
  so every Accent consumer inside follows it; the Collection List Card's
  Accent card colour is always the scheme's neutral accent). Composes only `rich_content` and `list_collections`.
{%- endcomment -%}

{% style %}
  /* One accent per section. Doubled class so it outranks the colour-scheme
     class on the same element. */
  .collection-list.collection-list--{{ section.id }} {
    {% render 'accent-resolver', source: section.settings %}
  }

  .collection-list--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    /* ---- shell ---- */
    padding-block: var(--ds-section-padding-mobile);
    padding-inline: 0;
    background-color: {% render 'background-role-token', key: section.settings.background_role %};

    /* ---- layout box ---- */
    --collection-list-pad-x: var(--ds-layout-gutter-mobile);

    gap: var(--ds-layout-gap-mobile);
  }

  .collection-list--{{ section.id }} .collection-list__inner {
    display: flex;
    flex-direction: column;
    gap: var(--ds-layout-gap-mobile);
  }

  @media (min-width: 768px) {
    .collection-list--{{ section.id }} {
      padding-block: var(--ds-section-padding-desktop);
      gap: var(--ds-layout-gap-desktop);

      --collection-list-pad-x: var(--ds-layout-gutter-desktop);
    }

  .collection-list--{{ section.id }} .collection-list__inner {
    display: flex;
    flex-direction: column;
    gap: var(--ds-layout-gap-desktop);
  }
  }
{% endstyle %}

<section
  id="CollectionList-{{ section.id }}"
  class="collection-list collection-list--{{ section.id }} color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="collection-list__inner" style="padding-inline: var(--collection-list-pad-x);">
    {% content_for 'blocks' %}
  </div>
</section>

{% schema %}
{
