{%- comment -%}
  CLASSIC COLLECTION TABS (`cls-`) — a classic section: a heading and a row of
  tabs, spaced apart, over the products of the collection picked in the open
  tab, as a grid or a carousel per breakpoint. No hero. Each Tab block picks
  one collection; the section decides how many products every tab shows.
  Cards are the Collection Product Card, shaped by --opc-ratio.
  Carousels are native scroll-snap; entrances come from
  snippets/motion-reveal.liquid.
  Depends on: snippets/classic-head.liquid, snippets/classic-panel.liquid,
  snippets/collection-product-card.liquid, snippets/motion-reveal.liquid,
  assets/classic-tabs.js (<classic-tabs>).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign layout_mobile = s.layout_mobile | default: 'carousel'
  assign layout_desktop = s.layout_desktop | default: 'grid'
  assign arrows = false
  if layout_desktop == 'carousel' and s.show_arrows
    assign arrows = true
  endif
-%}

{%- capture head_motion -%}{% render 'motion-reveal', part: 'class', from: s %}{%- endcapture -%}
{%- capture track_motion -%}{% render 'motion-reveal', part: 'class', from: s, group: true %}{%- endcapture -%}

<script src="{{ 'classic-tabs.js' | asset_url }}" defer></script>

{% style %}
  .cls--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    --cls-cols-mobile: {{ s.columns_mobile }};
    --cls-view-mobile: {{ s.columns_mobile | plus: 0.25 }};
    --cls-cols-desktop: {{ s.columns_desktop }};
    {% render 'motion-reveal', part: 'vars', from: s %}
    --cls-ratio: {{ s.card_ratio | default: '4/5' }};
    --opc-ratio: var(--cls-ratio);
  }
{% endstyle %}

<classic-tabs
  class="cls cls--{{ section.id }} cls--m-{{ layout_mobile }} cls--d-{{ layout_desktop }} color-{{ s.color_scheme }}"
  data-cls-layout-mobile="{{ layout_mobile }}"
  data-cls-layout-desktop="{{ layout_desktop }}"
  data-opc-cart="slide"
>
  <div class="cls__inner">
    {% render 'classic-head', id: section.id, source: s, tabs: section.blocks, motion: head_motion %}
    <div class="cls-stage">
      {%- for block in section.blocks -%}
        {%- capture items -%}
          {%- assign tab_collection = block.settings.collection -%}
          {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
            {%- for product in tab_collection.products limit: s.products_count -%}
              <div class="cls-slide">
                {% render 'collection-product-card', product: product, index: forloop.index %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..s.columns_desktop) -%}
              <div class="cls-slide">
                {% render 'collection-product-card', index: i %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}
        {% render 'classic-panel', id: section.id, index: forloop.index0, items: items, active: forloop.first, arrows: arrows, motion: track_motion %}
      {%- endfor -%}
    </div>
  </div>
</classic-tabs>

