{%- comment -%}
  Before & After — a fixed two-part editorial row: one Rich Content block and
  one Before & After Slider block, both statically rendered so the composition
  never changes shape. The section owns only the color scheme, vertical
  spacing, the single horizontal gutter, the direct-block gap and the row
  direction; width, alignment and content belong to the two blocks.

  Layout "Slider only" skips the Rich Content block and lets the slider span
  the whole section, sized by its own aspect ratio (Comparison Editorial
  style), so it can fill a large screen.

  Direction settings reverse the visual flow in code only — the Rich Content
  block always stays first in the markup, so neither the Theme Editor ordering
  nor a screen reader's reading order changes.

  Direct dependencies: snippets/section-design-mode.liquid and
  snippets/background-role-token.liquid.
{%- endcomment -%}

{%- liquid
  assign slider_only = false
  if section.settings.layout == 'slider'
    assign slider_only = true
  endif

  assign direction_mobile = 'column'
  if section.settings.direction_mobile == 'reverse'
    assign direction_mobile = 'column-reverse'
  endif

  assign direction_desktop = 'row'
  if section.settings.direction_desktop == 'reverse'
    assign direction_desktop = 'row-reverse'
  endif

  assign align_y = 'center'
  if section.settings.align_y == 'top'
    assign align_y = 'flex-start'
  elsif section.settings.align_y == 'bottom'
    assign align_y = 'flex-end'
  elsif section.settings.align_y == 'stretch'
    assign align_y = 'stretch'
  endif
-%}

{% style %}
  .before-after--{{ section.id }} {
    {% render 'section-design-mode', section_settings: section.settings %}
    box-sizing: border-box;
    width: 100%;
    padding-block: var(--ds-section-padding-mobile);
    padding-inline: 0;
    background-color: {% render 'background-role-token', key: section.settings.background_role %};
    color: var(--color-text);
    overflow-x: clip;
    overflow-y: visible;
  }

  .before-after--{{ section.id }} .before-after__row {
    box-sizing: border-box;
    display: flex;
    flex-direction: {{ direction_mobile }};
    align-items: stretch;
    gap: var(--ds-layout-gap-mobile);
    width: 100%;
    max-width: var(--ds-section-width-mobile);
    margin-inline: auto;
    padding-inline: var(--ds-layout-gutter-mobile);
  }

  .before-after--{{ section.id }} .before-after__col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .before-after--{{ section.id }} {
      padding-block: var(--ds-section-padding-desktop);
    }

    .before-after--{{ section.id }} .before-after__row {
      flex-direction: {{ direction_desktop }};
      align-items: {{ align_y }};
      gap: var(--ds-layout-gap-desktop);
      max-width: var(--ds-section-width-desktop);
      padding-inline: var(--ds-layout-gutter-desktop);
    }

    .before-after--{{ section.id }} .before-after__col--content {
      flex: {{ section.settings.content_ratio }} 1 0;
      width: auto;
    }

    .before-after--{{ section.id }} .before-after__col--slider {
      {%- if slider_only %}
        flex: 1 1 100%;
      {%- else %}
        flex: {{ section.settings.slider_ratio }} 1 0;
      {%- endif %}
      width: auto;
    }
  }
{% endstyle %}

<section class="before-after--{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="before-after__row">
    {%- unless slider_only -%}
      <div class="before-after__col before-after__col--content">
        {% content_for 'block', type: 'rich_content', id: 'content' %}
      </div>
    {%- endunless -%}

    <div class="before-after__col before-after__col--slider">
      {% content_for 'block', type: '_before_after', id: 'slider' %}
    </div>
  </div>
</section>

